---
import MainLayout from '../../layouts/MainLayout.astro';
import BlogPostPreview from '../../components/blog/BlogPostPreview.astro';
import SectionHeading from '../../components/visual/SectionHeading.astro';
import InkCollision from '../../components/visual/InkCollision.astro';
import PrintTitleText from '../../components/visual/PrintTitleText.astro';
import '../../styles/blog-print.scss';
import type { Frontmatter } from '@data/frontmatter';
import type { MarkdownInstance } from 'astro';

const pageDetails = {
   title: 'Blog',
   description:
      'Blog posts by Kival Evan about software development, Beat Saber, and this website.',
   overrideTitle: false,
};

const allPosts = Object.values(
   import.meta.glob<MarkdownInstance<Frontmatter>>('./post/*.md', { eager: true }),
).sort(
   (a, b) =>
      new Date(b.frontmatter.publishDate).valueOf() - new Date(a.frontmatter.publishDate).valueOf(),
);
const latestPost = allPosts[0];
const earlierPosts = allPosts.slice(1);
---

<MainLayout pageDetails={pageDetails}>
   <div class="blog-index site-shell">
      <section aria-labelledby="notebook-heading" class="blog-opening">
         <div class="blog-opening__collision">
            <InkCollision />
         </div>
         <header class="blog-opening__header">
            <h2 id="notebook-heading" class="blog-opening__title">
               <PrintTitleText text="Blog" />
            </h2>
            <p class="blog-count">
               {allPosts.length} {allPosts.length === 1 ? 'post' : 'posts'} | newest first
            </p>
         </header>

         {latestPost && (
            <div class="blog-opening__latest" aria-labelledby="latest-note">
               <h2 id="latest-note" class="blog-opening__latest-label">
                  Latest post
               </h2>
               <BlogPostPreview post={latestPost} featured />
            </div>
         )}
      </section>

      {!latestPost && (
         <p class="blog-index__empty" role="status">
            No posts are published yet.
         </p>
      )}

      {earlierPosts.length > 0 && (
         <section aria-labelledby="earlier-notes" class="blog-archive">
            <SectionHeading id="earlier-notes" title="Earlier posts" level="h2" density="low" />
            <ol class="blog-list">
               {earlierPosts.map((post) => (
                  <li class="blog-list__item">
                     <BlogPostPreview post={post} />
                  </li>
               ))}
            </ol>
         </section>
      )}
   </div>
</MainLayout>

<style lang="scss">
   @layer layout {
      .blog-index {
         display: flex;
         flex-direction: column;
         gap: 3rem;
         padding: 2rem 0.75rem;

         &__empty {
            padding-block: 1.5rem;
            border-block: 1px solid rgb(255 255 255 / 50%);
            text-align: center;
         }
      }

      .blog-count {
         margin-top: 0.75rem;
         font-size: 0.875rem;
         line-height: 1.25rem;
      }

      .blog-list {
         margin-top: 1.25rem;

         &__item {
            padding-block: 1.25rem;

            &:first-child {
               padding-top: 1rem;
            }

            &:last-child {
               padding-bottom: 1rem;
            }
         }
      }

      @media (min-width: 40rem) {
         .blog-index {
            padding-inline: 1.5rem;
         }
      }

      @media (min-width: 48rem) {
         .blog-index {
            padding: 3rem 2rem;
         }
      }
   }
</style>
