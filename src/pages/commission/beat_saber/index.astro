---
import MainLayout from '../../../layouts/MainLayout.astro';
import BeatmapList from '../../../components/commission/BeatmapList.svelte';
import SectionHeading from '../../../components/visual/SectionHeading.astro';
import InkCollision from '../../../components/visual/InkCollision.astro';
import PrintTitleText from '../../../components/visual/PrintTitleText.astro';
import { formatDate } from '../../../utils/date';
import Commission from '../../../data/commission.json' with { type: 'json' };
import '../../../styles/commission-print.scss';
import '../../../styles/commission-layout.scss';

const pageDetails = {
   title: 'Commission',
   subtitle: 'Beat Saber Custom Map',
   browserTitle: 'Beat Saber Custom Map Commission',
   noSubtitle: true,
   description:
      'Beat Saber custom map commission prices, proof, delivery details, and order options.',
   overrideTitle: false,
   overrideSubtitle: true,
};
---

<MainLayout pageDetails={pageDetails}>
   <div class="commission-page">
      <div class="commission-hero">
         <div class="commission-hero__collision">
            <InkCollision />
         </div>
         <div class="commission-hero__photo" aria-hidden="true">
            <div class="commission-hero__image"></div>
         </div>
         <div class="commission-hero__paper">
            <h2 class="commission-banner">
               <PrintTitleText text="Beat Saber Custom Map" />
            </h2>
            <section
               id="service-summary"
               class="commission-opening"
               aria-labelledby="service-summary-heading"
            >
               <header class="commission-section__heading">
                  <SectionHeading
                     id="service-summary-heading"
                     title="Custom map commissions"
                     density="low"
                  />
                  <p class="commission-section__intro">
                     I have made Beat Saber maps in many styles for more than six years. I have been
                     involved in the ranked scene, playlists, and other parts of the community. I
                     mainly map Touhou Project arrangements and give each song its own creative
                     direction.
                  </p>
               </header>
            </section>
         </div>
      </div>

      <section
         id="proof"
         class="commission-section commission-section--proof site-shell"
         aria-label="Proof of mapping work"
      >
         <header class="site-reading-width commission-proof__intro">
            <p class="commission-proof__copy">
               My public work includes contest placements, lighting nominations, and a published map
               portfolio.
            </p>
         </header>
         <ul class="commission-proof-list">
            <li>
               <span>Top 100 BeatSaver</span>
            </li>
            <li>
               <span>Building Block 2025 | Standard - 1st Place</span>
            </li>
            <li>
               <span>Beasties 2024 - Best Vanilla+ Light - Nominee</span>
            </li>
            <li>
               <span>Beasties 2022 - Best Vanilla+ Light - Runner-Up</span>
            </li>
            <li>
               <span>BSMG Halloween 2022 Mapping Contest - 3rd Place</span>
            </li>
            <li>
               <span>Building Block 2020 - 3rd Place</span>
            </li>
         </ul>
         <nav class="commission-proof-links" aria-label="Mapping proof links">
            <a class="commission-proof-links__link" href="https://beatsaver.com/profile/4285062">
               BeatSaver profile <span aria-hidden="true">↗</span>
            </a>
            <a
               class="commission-proof-links__link"
               href="https://bsaber.com/songs/new/?uploaded_by=kivalevan"
            >
               BeastSaber maps <span aria-hidden="true">↗</span>
            </a>
            <a
               class="commission-proof-links__link"
               href="https://scoresaber.com/u/76561198002258649"
            >
               ScoreSaber results <span aria-hidden="true">↗</span>
            </a>
            <a
               class="commission-proof-links__link"
               href="https://youtube.com/playlist?list=PLp4N5ZtOuDZlhdvoH1INSPn2Qn9zrD19b"
            >
               Video Preview <span aria-hidden="true">↗</span>
            </a>
         </nav>
      </section>

      <section
         id="delivery"
         class="commission-section commission-section--delivery site-shell"
         aria-labelledby="delivery-heading"
      >
         <header class="site-reading-width commission-section__heading">
            <SectionHeading id="delivery-heading" title="Order and delivery" density="low" />
            <p class="commission-section__intro">
               Delivery usually takes 1-2 weeks. My availability, the song, and the selected options
               can change the schedule. I share progress during the order so that you can give
               feedback.
            </p>
         </header>
         <div id="enquiry" class="site-reading-width commission-enquiry">
            <p>To order a map or ask a question, contact me through Discord or email.</p>
            <ul class="commission-enquiry__actions">
               <li>
                  <button
                     class="discord-popup print-action commission-enquiry__copy"
                     type="button"
                     data-discord-popup="true"
                     title="Copy Discord username @kivalevan"
                     aria-label="Copy Discord username @kivalevan"
                  >
                     Copy Discord username
                  </button>
               </li>
               <li>
                  <a class="print-action" href="mailto:kivalevan@gmail.com">
                     Send email
                  </a>
               </li>
            </ul>
            <p class="commission-enquiry__details">
               Please read below for <a href="#pricing">Pricing and payment</a> and
               <a href="#tnc">Terms &amp; Conditions</a> for further information.
               <br />
               Once the order is made, you have accepted the{' '}
               <a href="#tnc">Terms &amp; Conditions</a>.
            </p>
         </div>
      </section>

      <section
         id="pricing"
         class="commission-section commission-section--pricing site-shell"
         aria-labelledby="pricing-heading"
      >
         <header class="site-reading-width commission-section__heading">
            <SectionHeading id="pricing-heading" title="Pricing and payment" density="low" />
            <p class="commission-section__intro commission-section__intro--narrow">
               Use the estimator for a quick total. Open the detailed rates when you need to compare
               difficulties, lighting, bonuses, and payment options.
            </p>
            <a
               class="print-action commission-section__action"
               href="/commission/beat_saber/cost_estimator/"
            >
               Open the cost estimator
            </a>
         </header>
         <div class="commission-rates">
            <div class="commission-rates__grid">
               <article class="commission-rate-panel">
                  <h3 class="commission-rate-panel__heading">Mapping rates</h3>
                  <dl class="commission-rate-panel__rates">
                     <div class="commission-rate-panel__rate">
                        <dt class="commission-rate-panel__amount">
                           ${Commission.beatmap.base + Commission.beatmap.difficulty.expertPlus}
                        </dt>
                        <dd class="commission-rate-panel__name">Expert+</dd>
                        <p class="commission-rate-panel__description">
                           Uses dense, complex patterns that represent more details from the song.
                        </p>
                     </div>
                     <div class="commission-rate-panel__rate">
                        <dt class="commission-rate-panel__amount">
                           ${Commission.beatmap.base + Commission.beatmap.difficulty.expert}
                        </dt>
                        <dd class="commission-rate-panel__name">Expert</dd>
                        <p class="commission-rate-panel__description">
                           Follows the rhythm and prominent instruments with a challenging pattern.
                        </p>
                     </div>
                     <div class="commission-rate-panel__rate">
                        <dt class="commission-rate-panel__amount">
                           ${Commission.beatmap.base + Commission.beatmap.difficulty.hard}
                        </dt>
                        <dd class="commission-rate-panel__name">Hard</dd>
                        <p class="commission-rate-panel__description">
                           A faster-paced map that challenges casual players without reaching Expert
                           difficulty.
                        </p>
                     </div>
                     <div class="commission-rate-panel__rate">
                        <dt class="commission-rate-panel__amount">
                           ${Commission.beatmap.base + Commission.beatmap.difficulty.normal}
                        </dt>
                        <dd class="commission-rate-panel__name">Normal</dd>
                        <p class="commission-rate-panel__description">
                           An approachable challenge for casual players.
                        </p>
                     </div>
                     <div class="commission-rate-panel__rate">
                        <dt class="commission-rate-panel__amount">
                           ${Commission.beatmap.base + Commission.beatmap.difficulty.easy}
                        </dt>
                        <dd class="commission-rate-panel__name">Easy</dd>
                        <p class="commission-rate-panel__description">
                           A sparse introductory map for new and returning players.
                        </p>
                     </div>
                     <div class="commission-rate-panel__rate">
                        <dt class="commission-rate-panel__amount">Ask for a price</dt>
                        <dd class="commission-rate-panel__name">One Saber</dd>
                        <p class="commission-rate-panel__description">
                           A one-handed map. It costs half the Standard map rate when ordered with a
                           Standard difficulty. Otherwise, it uses the full rate.
                        </p>
                     </div>
                  </dl>
               </article>

               <article class="commission-rate-panel">
                  <h3 class="commission-rate-panel__heading">Lighting rates</h3>
                  <dl class="commission-rate-panel__rates">
                     <div class="commission-rate-panel__rate">
                        <dt class="commission-rate-panel__amount">
                           ${Commission.beatmap.lighting.chromaAdvanced}
                        </dt>
                        <dd class="commission-rate-panel__name">Chroma Advanced</dd>
                        <p class="commission-rate-panel__description">
                           Controls individual lights to create complex Chroma effects.
                        </p>
                     </div>
                     <div class="commission-rate-panel__rate">
                        <dt class="commission-rate-panel__amount">
                           ${Commission.beatmap.lighting.chromaBasic}
                        </dt>
                        <dd class="commission-rate-panel__name">Chroma Basic</dd>
                        <p class="commission-rate-panel__description">
                           Uses Chroma color and rotation controls without per-light effects.
                        </p>
                     </div>
                     <div class="commission-rate-panel__rate">
                        <dt class="commission-rate-panel__amount">
                           ${Commission.beatmap.lighting.vanillaV3}
                        </dt>
                        <dd class="commission-rate-panel__name">Vanilla (v3)</dd>
                        <p class="commission-rate-panel__description">
                           Advanced base-game lighting introduced with Weave.
                        </p>
                     </div>
                     <div class="commission-rate-panel__rate">
                        <dt class="commission-rate-panel__amount">
                           ${Commission.beatmap.lighting.vanillaV2}
                        </dt>
                        <dd class="commission-rate-panel__name">Vanilla (v2)</dd>
                        <p class="commission-rate-panel__description">
                           Basic base-game lighting for standard or custom environments from before
                           Weave.
                        </p>
                     </div>
                     <div class="commission-rate-panel__rate">
                        <dt class="commission-rate-panel__amount">Free</dt>
                        <dd class="commission-rate-panel__name">Lolighter (automated lighting)</dd>
                        <p class="commission-rate-panel__description">
                           The lighting is generated automatically and can be underwhelming in some
                           scenarios.
                        </p>
                     </div>
                     <div class="commission-rate-panel__rate">
                        <dt class="commission-rate-panel__amount">Free</dt>
                        <dd class="commission-rate-panel__name">Static / None</dd>
                        <p class="commission-rate-panel__description">
                           Uses static lighting or no lighting changes. This option applies to GLS
                           environments.
                        </p>
                     </div>
                  </dl>
               </article>

               <article class="commission-rate-panel">
                  <h3 class="commission-rate-panel__heading">Optional extras</h3>
                  <dl class="commission-rate-panel__rates">
                     <div class="commission-rate-panel__rate">
                        <dt class="commission-rate-panel__amount">Free</dt>
                        <dd class="commission-rate-panel__name">Difficulty Label</dd>
                     </div>
                     <div class="commission-rate-panel__rate">
                        <dt class="commission-rate-panel__amount">Free</dt>
                        <dd class="commission-rate-panel__name">Custom Colour</dd>
                     </div>
                     <div class="commission-rate-panel__rate">
                        <dt class="commission-rate-panel__amount">Free</dt>
                        <dd class="commission-rate-panel__name">Chroma Object</dd>
                     </div>
                     <div class="commission-rate-panel__rate">
                        <dt class="commission-rate-panel__amount">Free</dt>
                        <dd class="commission-rate-panel__name">Cinema Integration</dd>
                     </div>
                     <div class="commission-rate-panel__rate">
                        <dt class="commission-rate-panel__amount">Ask for a price</dt>
                        <dd class="commission-rate-panel__name">Custom Environment</dd>
                        <p class="commission-rate-panel__description">
                           I can reuse an existing platform or create a new, unique environment from
                           your references.
                        </p>
                     </div>
                  </dl>
               </article>
            </div>
            <div class="site-reading-width commission-pricing-notes">
               <div>
                  <h3>Pricing notes</h3>
                  <ul class="list-arrow commission-pricing-notes__list">
                     <li>
                        Optional extras are free. If I enjoy the song and the map allows for
                        creativity, you may receive one of the listed extras. You can request an
                        extra, but I cannot guarantee it. I can use an existing custom environment
                        when it fits the map.
                     </li>
                     <li>
                        Rates can increase for complex songs, difficult mapping work, or multiple
                        complex BPM changes.
                     </li>
                     <li>Difficulty scaling uses recent OST maps and the needs of each song.</li>
                  </ul>
               </div>
               <div>
                  <p>
                     <a class="print-action" href="/commission/beat_saber/cost_estimator/">
                        Cost Estimator
                     </a>
                  </p>
                  <p>
                     The estimate uses the rate per minute and rounds song length up to a whole or
                     half minute. Pricing is subject to change, so read the note above.
                  </p>
                  <div>
                     <h3>Payment options</h3>
                     <ul class="list-arrow commission-pricing-notes__list">
                        <li>50% upfront, 50% upon delivery</li>
                        <li>100% upfront</li>
                     </ul>
                     <p>
                        Payment uses <a href="https://ko-fi.com/kivalevan">Ko-fi</a> or PayPal in
                        USD, excluding tax. Ask if you need another trusted payment method. Tips are
                        appreciated.
                     </p>
                  </div>
               </div>
            </div>
         </div>
      </section>

      <section
         id="map-showcase"
         class="commission-section commission-section--showcase site-shell"
         aria-labelledby="map-showcase-heading"
      >
         <header class="site-reading-width commission-section__heading">
            <SectionHeading id="map-showcase-heading" title="Map showcase" density="low" />
            <p class="commission-section__intro">
               Browse personal releases and maps made for requested songs. Each entry links to
               BeatSaver and an available web preview.
            </p>
         </header>
         <hr class="commission-rule" />
         <BeatmapList client:visible={{ rootMargin: '300px' }} />
      </section>

      <section
         id="tnc"
         class="commission-section commission-section--terms site-shell"
         aria-labelledby="tnc-heading"
      >
         <div class="site-reading-width commission-terms__heading">
            <SectionHeading id="tnc-heading" title="Terms & Conditions" density="low" />
         </div>
         <div class="site-reading-width commission-terms">
            <ul class="list-arrow commission-terms__list">
               <li>I have the right to deny any commission.</li>
               <li>The beatmap will be uploaded to my own BeatSaver account.</li>
               <li>
                  Agree to abide by
                  <a href="https://beatsaver.com/policy/tos">BeatSaver's terms and conditions</a>.
               </li>
               <li>
                  Requestor will not be named in beatmap description by default for privacy reason,
                  but can be included if requested.
               </li>
               <li>
                  Beatmap will be released &amp; uploaded as soon after completion and full payment
                  made, but are allowed to request scheduled release.
               </li>
               <li>
                  Beatmap released have a week of liability in case of the map is below satisfactory
                  level or issues found that mandate changes or fixes. Broken beatmap will be fixed
                  regardless whenever notified due to unforeseeable update.
               </li>
               <li>
                  Song length depend on valid metadata if exist, otherwise use given audio source;
                  use valid minimum length for edge case scenario.
               </li>
               <li>
                  Expected delivery time will be around 1-2 weeks but may vary depending on
                  availability and option, I'll keep in touch showcasing progress and other related
                  detail, you are allowed to give feedback on recent progress.
               </li>
               <li>
                  You may request to change song within the first draft period. Charged accordingly
                  from original request to new request, no refund for lesser request swap. Any
                  subsequent swap are considered new request.
               </li>
               <li>Please do not spam or excessively remind me in short period of time.</li>
               <li>
                  Lighting will take another considerable chunk of time. If you wish to receive the
                  map sooner, consider switching to Lolighter option, the payment will be refunded
                  or discounted by lighting cost.
               </li>
               <li>
                  I have full control over what or how I map; this typically mean it will be high
                  difficulty in mind. You are free to suggest what you want in the map, including
                  but not limited to specific difficulty, note pattern, etc. However, It is not
                  guaranteed to be applied and I have the right to refuse such that it involve bad
                  mapping practice, against my mapping habit, or anything I disagree with.
               </li>
               <li>
                  Additional detail such as difficulty label, custom colour, base platform, etc is
                  allowed and free-of-charge. Exception, detail such as obscene text, similar
                  coloured note, and other I disagree or deemed inappropriate will be rejected.
               </li>
               <li>
                  I may not accept nor take request outside product listed here (such as curation,
                  playlist, ranking, advert, etc), however it is negotiable.
               </li>
               <li>
                  I may cancel the commission at any time and you will receive full refund and
                  disclosure for cancellation.
               </li>
            </ul>
            <br />
            <span>Last updated: {formatDate('18 March 2025')}</span>
            <br />
            <br />
            <span>
               <strong>Note:</strong> Terms &amp; Conditions is subjected to change; may not be
               applicable to existing order or enquiry depending on importance or severity.
            </span>
            <br />
            <br />
         </div>
      </section>
   </div>
</MainLayout>
