---
import MainLayout from '../../../layouts/MainLayout.astro';
import { Image } from 'astro:assets';
import chromapper from '../../../assets/img/cv/chromapper.png';
import mapCheck from '../../../assets/img/cv/bsmc.png';
import editorEnhanced from '../../../assets/img/cv/bsee.png';
import SectionHeading from '../../../components/visual/SectionHeading.astro';
import InkCollision from '../../../components/visual/InkCollision.astro';
import '../../../styles/project-print.scss';
import '../../../styles/project-layout.scss';

const pageDetails = {
   title: 'Projects',
   subtitle: 'Beat Saber',
   browserTitle: 'Beat Saber Projects',
   description:
      'Beat Saber tools for making and reviewing maps, published maps, and open-source work by Kival Evan.',
   overrideTitle: false,
};
---

<MainLayout pageDetails={pageDetails}>
   <div class="beat-saber-page site-shell">
      <section
         id="software-tools"
         aria-labelledby="software-tools-heading"
         class="beat-saber-page__section"
      >
         <div class="project-opening tool-opening">
            <div class="tools-opening__collision">
               <InkCollision />
            </div>
            <header class="tool-opening__header">
               <SectionHeading
                  id="software-tools-heading"
                  title="Software and Tools"
                  density="medium"
               />
               <p class="tool-opening__intro">
                  Tools for making, editing, and checking Beat Saber maps.
               </p>
            </header>
            <article class="tool-lead">
               <div class="tool-lead__pocket">
                  <h3 class="project-title project-title--large">
                     <a
                        class="project-title-link"
                        href="https://kivalevan.github.io/BeatSaber-MapCheck/"
                     >
                        Map Check
                     </a>
                  </h3>
                  <p class="project-meta project-meta--lead">
                     Personal project · TypeScript · SolidJS
                  </p>
                  <p class="tool-lead__description">
                     A browser-based map checker used by more than 500 mappers to inspect Beat Saber
                     map details, statistics, and possible errors before release. The reusable BSMap
                     library contains its map-reading and error-checking code.
                  </p>
                  <nav class="tool-lead__actions" aria-label="Map Check actions">
                     <a
                        class="project-action print-action"
                        href="https://kivalevan.github.io/BeatSaber-MapCheck/"
                     >
                        Open Map Check <span aria-hidden="true">↗</span>
                     </a>
                     <a
                        class="project-action print-action"
                        href="https://github.com/KivalEvan/BeatSaber-MapCheck"
                     >
                        View source <span aria-hidden="true">↗</span>
                     </a>
                  </nav>
               </div>
               <figure class="tool-lead__image">
                  <Image
                     src={mapCheck}
                     alt="Beat Saber Map Check interface"
                     class="tool-lead__media"
                     widths={[384, 512, 640, 800, 1024]}
                     sizes="(min-width: 64rem) min(57.5vw, 50rem), (min-width: 48rem) calc(100vw - 4rem), calc(100vw - 2.5rem)"
                     loading="eager"
                  />
               </figure>
            </article>
         </div>
         <div class="tool-ledger">
            <article class="tool-entry tool-entry--chromapper">
               <figure class="tool-entry__image tool-entry__image--chromapper">
                  <Image
                     src={chromapper}
                     alt="ChroMapper editor preview"
                     class="tool-entry__media"
                     widths={[384, 512, 640, 800, 1024]}
                     sizes="(min-width: 48rem) min(40vw, 35rem), calc(100vw - 2.5rem)"
                     loading="lazy"
                     decoding="async"
                  />
               </figure>
               <div class="tool-entry__copy">
                  <h3 class="project-title project-title--entry">
                     <a class="project-title-link" href="https://github.com/Caeden117/ChroMapper">
                        ChroMapper
                     </a>
                  </h3>
                  <p class="project-meta project-meta--entry">
                     Open-source contributor · Unity · C# · HLSL
                  </p>
                  <p class="tool-entry__description">
                     Contributed to the move from Unity 2021 to Unity 6.3 and refactored C# systems
                     and HLSL shaders. This improved runtime performance, memory use, and how
                     closely the lighting preview matches the game.
                  </p>
                  <nav class="tool-entry__actions" aria-label="ChroMapper actions">
                     <a
                        class="project-action print-action"
                        href="https://github.com/Caeden117/ChroMapper"
                     >
                        View repository <span aria-hidden="true">↗</span>
                     </a>
                  </nav>
               </div>
            </article>

            <article class="tool-entry tool-entry--enhanced">
               <div class="tool-entry__copy">
                  <h3 class="project-title project-title--entry">
                     <a
                        class="project-title-link"
                        href="https://github.com/KivalEvan/BeatSaber-EditorEnhanced"
                     >
                        Editor Enhanced
                     </a>
                  </h3>
                  <p class="project-meta project-meta--entry">
                     Personal project · Unity · C# · HLSL
                  </p>
                  <p class="tool-entry__description">
                     A C# modification for the official Beat Saber editor that improves lighting and
                     event-box editing. It adds interactive v3 controls for lighting and event
                     boxes.
                  </p>
                  <nav class="tool-entry__actions" aria-label="Editor Enhanced actions">
                     <a
                        class="project-action print-action"
                        href="https://github.com/KivalEvan/BeatSaber-EditorEnhanced"
                     >
                        View repository <span aria-hidden="true">↗</span>
                     </a>
                  </nav>
               </div>
               <figure class="tool-entry__image tool-entry__image--enhanced">
                  <Image
                     src={editorEnhanced}
                     alt="Beat Saber Editor Enhanced preview"
                     class="tool-entry__media"
                     widths={[384, 512, 640, 800, 1024]}
                     sizes="(min-width: 48rem) min(40vw, 35rem), calc(100vw - 2.5rem)"
                     loading="lazy"
                     decoding="async"
                  />
               </figure>
            </article>

            <article class="tool-entry tool-entry--library">
               <div>
                  <h3 class="project-title project-title--entry">
                     <a
                        class="project-title-link"
                        href="https://github.com/KivalEvan/BeatSaber-Deno"
                     >
                        BSMap
                     </a>
                  </h3>
                  <p class="project-meta project-meta--entry">Library · TypeScript</p>
               </div>
               <p class="tool-entry__description">
                  A TypeScript library for Beat Saber mapping. It provides the reusable code that
                  reads maps and applies the rules used by Map Check.
               </p>
               <nav class="tool-entry__actions" aria-label="BSMap actions">
                  <a
                     class="project-action print-action"
                     href="https://github.com/KivalEvan/BeatSaber-Deno"
                  >
                     View library <span aria-hidden="true">↗</span>
                  </a>
               </nav>
            </article>
         </div>
      </section>

      <section
         id="mapping-workshop"
         aria-labelledby="mapping-workshop-heading"
         class="beat-saber-page__section"
      >
         <header class="tool-opening__header">
            <SectionHeading
               id="mapping-workshop-heading"
               title="Mapping Workshop"
               density="medium"
            />
            <p class="tool-opening__intro">
               Published maps plus the utilities, scripts, and plugins I use for mapping.
            </p>
            <nav class="tool-opening__actions" aria-label="Mapping Workshop actions">
               <a class="project-action print-action" href="/commission/beat_saber/">
                  Commission a custom map <span aria-hidden="true">→</span>
               </a>
            </nav>
         </header>

         <article class="workshop-feature">
            <h3 class="project-title project-title--large workshop-feature__title">
               <a class="project-title-link" href="https://beatsaver.com/profile/4285062">
                  Published Beat Saber maps
               </a>
            </h3>
            <p class="project-meta project-meta--lead">Published maps</p>
            <p class="workshop-feature__description">
               Browse my public map portfolio on BeatSaver. You can also{' '}
               <a class="project-inline-link" href="/commission/beat_saber/">
                  commission me
               </a>{' '}
               to create a map for your favourite song.
            </p>
            <nav class="tool-entry__actions" aria-label="Map project actions">
               <a class="project-action print-action" href="https://beatsaver.com/profile/4285062">
                  Browse published maps <span aria-hidden="true">↗</span>
               </a>
            </nav>
         </article>

         <ul class="project-archive">
            <li>
               <h3 class="project-title project-title--archive">
                  <a
                     class="project-title-link"
                     href="https://kivalevan.github.io/BeatSaber-MappingUtility/"
                  >
                     Mapping Utility
                  </a>
               </h3>
               <p>A collection of web tools for Beat Saber mapping.</p>
            </li>
            <li>
               <h3 class="project-title project-title--archive">
                  <a
                     class="project-title-link"
                     href="https://github.com/KivalEvan/BeatSaber-MappingScript"
                  >
                     Mapping Script
                  </a>
               </h3>
               <p>TypeScript scripts for making Beat Saber maps with BSMap.</p>
            </li>
            <li>
               <h3 class="project-title project-title--archive">
                  <a
                     class="project-title-link"
                     href="https://github.com/KivalEvan/ChroMapper-Selector"
                  >
                     ChroMapper Selector Plugin
                  </a>
               </h3>
               <p>A ChroMapper plugin for selecting map objects.</p>
            </li>
         </ul>
      </section>

      <section class="site-prose permission-print" aria-labelledby="use-permission">
         <SectionHeading
            id="use-permission"
            title="Use & Permission"
            density="low"
            variant="hardware"
         />
         <div>
            <h3>Beatmap</h3>
            <p>
               As long as my map has already been published under BeatSaver, you may freely use them
               for video promotion, or any other purpose. My light are free to use in your map as
               long as credit is given. You may also use the map itself for any purpose including
               machine learning, but preferably if you ask first beforehand. Any other thing such as
               3D model, map script, etc. is allowed if and only when any of my map that uses them
               is publicly released on BeatSaver.
            </p>
            <h3>Code</h3>
            <p>Go ahead, just abide to licensing rule.</p>
         </div>
      </section>
   </div>
</MainLayout>

<style lang="scss">
   .tool-lead {
      &::before {
         right: -2%;
         top: 2rem;
         transform: rotate(11deg);
      }

      &::after {
         left: 47%;
         bottom: -1rem;
         transform: rotate(-15deg);
      }

      &__image {
         transform: translateY(1.25rem);
      }
   }

   .tool-entry {
      position: relative;

      &--chromapper {
         padding-right: 7%;
      }

      &--enhanced {
         padding-left: 5%;
      }

      &__image {
         box-shadow: 0 0.9rem 1.8rem rgb(3 3 5 / 0.3);
      }

      &--library {
         margin-top: 0.5rem;
      }
   }

   .workshop-feature {
      &::before {
         right: 4%;
         top: -2rem;
         transform: rotate(-13deg);
      }

      &::after {
         left: -2rem;
         bottom: -2rem;
         transform: rotate(19deg);
      }
   }

   .permission-print :global(.print-heading) {
      margin-bottom: 1.4rem;
   }

   .permission-print h3 {
      color: #ecebe6;
      font-family: var(--font-display);
      font-size: 2rem;
      line-height: 1;
      letter-spacing: -0.02em;
   }

   @media (max-width: 47.99rem) {
      .tool-entry--chromapper,
      .tool-entry--enhanced {
         padding: 0;
      }

      .tool-lead__image {
         transform: none;
      }
   }
</style>
