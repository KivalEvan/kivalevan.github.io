---
import MainLayout from '../layouts/MainLayout.astro';
import '../styles/home-background.css';
import '../styles/home-motion.css';
import '../styles/home-material.css';
import '../styles/home-ambient.css';
import '../styles/home-socials.css';
import FeaturedVideo from '../components/FeaturedVideo.svelte';
import InkPortrait from '../components/visual/InkPortrait.astro';
import ChromaticTitle from '../components/visual/ChromaticTitle.astro';
import SectionHeading from '../components/visual/SectionHeading.astro';
import contacts from '../data/contacts';
import info from '../data/info.js';
import { Icon } from 'astro-icon/components';
import heavyMassRaw from '../assets/ink/heavy-ink-mass-1.svg?raw';
import organicDrag1Raw from '../assets/ink/organic-drag-1.svg?raw';
import organicDrag2Raw from '../assets/ink/organic-drag-2.svg?raw';
import pigmentRedRaw from '../assets/ink/pigment-pool-red.svg?raw';
import pigmentBlueRaw from '../assets/ink/pigment-pool-blue.svg?raw';
import tangleRedRaw from '../assets/ink/ink-tangle-red.svg?raw';
import tangleBlueRaw from '../assets/ink/ink-tangle-blue.svg?raw';
import scratchesRaw from '../assets/ink/scratch-field-1.svg?raw';
import tornMassRaw from '../assets/ink/torn-mass-1.svg?raw';
import impactRaw from '../assets/ink/impact-cluster-2.svg?raw';
import splatter1Raw from '../assets/ink/splatter-cluster-1.svg?raw';
import splatter2Raw from '../assets/ink/splatter-cluster-2.svg?raw';
import splatter3Raw from '../assets/ink/splatter-cluster-3.svg?raw';
import sprayRaw from '../assets/ink/spray-fine-1.svg?raw';
import spray2Raw from '../assets/ink/spray-fine-2.svg?raw';
import frameMountRaw from '../assets/ink/frame-mount-1.svg?raw';

const pageDetails = {
   title: 'Kival Evan',
   description:
      "Kival Evan's personal site for software projects, Beat Saber mapping, writing, and everyday interests.",
   overrideTitle: true,
};

const today = new Date();
const birthYear = 1999;
const birthMonth = 5;
const birthDay = 10;
const birthDate = `${birthYear}-${String(birthMonth + 1).padStart(2, '0')}-${String(birthDay).padStart(2, '0')}`;
let age = today.getUTCFullYear() - birthYear;
if (
   today.getUTCMonth() < birthMonth ||
   (today.getUTCMonth() === birthMonth && today.getUTCDate() < birthDay)
) {
   age -= 1;
}
---

<MainLayout pageDetails={pageDetails}>
   <section aria-labelledby="hero-title" data-page-stagger-item class="mixed-hero">
      <script is:inline>
         (() => {
            const hero = document.currentScript.parentElement;
            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            // Prepare before artwork paints; a failed module must never leave it hidden.
            hero.dataset.homeMotionBoot = 'pending';
            window.setTimeout(() => {
               if (hero.dataset.homeMotionBoot === 'pending') {
                  hero.dataset.homeMotionBoot = 'expired';
               }
            }, 1500);
         })();
      </script>
      <div class="mixed-hero__art mixed-hero__art--back" aria-hidden="true">
         <div class="mixed-hero__art-field">
            <div class="mixed-hero__paper"><Fragment set:html={heavyMassRaw} /></div>
            <div class="mixed-hero__paper-impact"><Fragment set:html={tornMassRaw} /></div>
            <div class="mixed-hero__paper-burst"><Fragment set:html={splatter1Raw} /></div>
            <div class="mixed-hero__paper-spray"><Fragment set:html={sprayRaw} /></div>
            <div class="mixed-hero__red-spray"><Fragment set:html={spray2Raw} /></div>
            <div class="mixed-hero__blue-spray"><Fragment set:html={splatter2Raw} /></div>
            <div class="mixed-hero__paper-toner"><Fragment set:html={pigmentBlueRaw} /></div>
            <div class="mixed-hero__navy-pool"><Fragment set:html={pigmentBlueRaw} /></div>
            <div class="mixed-hero__red-pool"><Fragment set:html={pigmentRedRaw} /></div>
            <div class="mixed-hero__black-drag"><Fragment set:html={organicDrag1Raw} /></div>
            <div class="mixed-hero__red-tangle"><Fragment set:html={tangleRedRaw} /></div>
            <div class="mixed-hero__blue-tangle"><Fragment set:html={tangleBlueRaw} /></div>
            <div class="mixed-hero__decay"><Fragment set:html={scratchesRaw} /></div>
         </div>
      </div>

      <div class="site-shell mixed-hero__stage">
         <div class="mixed-hero__portrait"><InkPortrait /></div>

         <div class="mixed-hero__midground" aria-hidden="true">
            <div class="mixed-hero__navy-ribbon"><Fragment set:html={organicDrag2Raw} /></div>
            <div class="mixed-hero__paper-drag"><Fragment set:html={organicDrag1Raw} /></div>
            <div class="mixed-hero__paper-shock"><Fragment set:html={impactRaw} /></div>
            <div class="mixed-hero__red-vein"><Fragment set:html={tangleRedRaw} /></div>
         </div>

         <div class="mixed-hero__title">
            <ChromaticTitle id="hero-title" lines={['KIVAL', 'EVAN']} as="h1" />
         </div>

         <div class="mixed-hero__foreground" aria-hidden="true">
            <div class="mixed-hero__black-vein"><Fragment set:html={organicDrag2Raw} /></div>
            <div class="mixed-hero__paper-scratches"><Fragment set:html={scratchesRaw} /></div>
            <div class="mixed-hero__paper-splatter"><Fragment set:html={splatter3Raw} /></div>
            <div class="mixed-hero__red-deposit"><Fragment set:html={pigmentRedRaw} /></div>
         </div>

         <div class="mixed-hero__bio">
            <p class="mixed-hero__bio-lead">I build software, tools, and things for VR.</p>
            <p class="mixed-hero__bio-copy">
               I also play and map <em>Beat Saber</em>, and contribute to third-party mapping tools
               and scripts. I learn by building web applications, tools, and systems.
            </p>
         </div>

         <div class="mixed-hero__actions">
            <ul aria-label="Find me online" class="mixed-hero__socials">
               {
                  contacts.map((contact) => {
                     const label = contact.place === 'X (Twitter)' ? 'X' : contact.place;
                     return contact.url ? (
                        <li>
                           <a href={contact.url} aria-label={contact.place}>
                              <Icon name={contact.icon} aria-hidden="true" />
                              <span>{label}</span>
                           </a>
                        </li>
                     ) : (
                        <li>
                           <button
                              type="button"
                              title={contact.name}
                              aria-label={contact.place}
                              data-discord-popup={contact.place === 'Discord' ? true : undefined}
                           >
                              <Icon name={contact.icon} aria-hidden="true" />
                              <span>{label}</span>
                           </button>
                        </li>
                     );
                  })
               }
            </ul>
         </div>

         <p class="mixed-hero__meta">
            <b>Age</b>
            <span id="age" data-age data-birth-date={birthDate}>{age}</span> · June 10<br />
            Avatar art by <a href="https://www.pixiv.net/en/users/1020785">まひる</a>
         </p>
      </div>
   </section>

   <section
      data-page-stagger-item
      aria-labelledby="featured-heading"
      class="home-section home-section--featured w-full px-3 sm:px-6 md:px-8"
   >
      <div class="site-shell">
         <SectionHeading
            id="featured-heading"
            title="Featured video"
            density="medium"
            variant="featured"
         />
         <div class="punk-video">
            <div class="punk-video__mount" aria-hidden="true">
               <Fragment set:html={frameMountRaw} />
            </div>
            <div class="punk-video__navy" aria-hidden="true">
               <Fragment set:html={organicDrag2Raw} />
            </div>
            <div class="punk-video__red" aria-hidden="true">
               <Fragment set:html={pigmentRedRaw} />
            </div>
            <div class="punk-video__frame">
               <FeaturedVideo client:visible />
            </div>
         </div>
      </div>
   </section>

   <section
      data-page-stagger-item
      aria-labelledby="skills-heading"
      id="skills"
      class="home-section home-section--skills w-full scroll-mt-6 px-3 sm:px-6 md:px-8"
   >
      <div class="site-shell">
         <SectionHeading
            id="skills-heading"
            title="Skills & Interests"
            density="low"
            variant="skills"
         />
         <div class="skills-field site-reading-width text-lg">
            <div class="skills-group skills-group--tools">
               <h3 class="punk-h3">Languages &amp; Technologies</h3>
               <ul class="punk-tags">
                  {[...info.languages, ...info.techs].map((e) => <li>{e}</li>)}
               </ul>
            </div>
            <div class="skills-group skills-group--topics">
               <h3 class="punk-h3">Topics</h3>
               <ul class="punk-tags">
                  {info.topics.map((e) => <li>{e}</li>)}
               </ul>
            </div>
            <p class="punk-note">
               These are tools and topics I have used. This list does not show my level of
               proficiency.
            </p>
         </div>
      </div>
   </section>

   <section
      data-page-stagger-item
      aria-labelledby="hardware-heading"
      class="home-section home-section--hardware w-full px-3 sm:px-6 md:px-8"
   >
      <div class="site-shell">
         <SectionHeading
            id="hardware-heading"
            title="Current hardware"
            density="low"
            variant="hardware"
         />
         <div class="punk-hardware">
            <div>
               <h3>PC Setup</h3>
               <ul>
                  <li>Intel Core i9-12900K</li>
                  <li>Sapphire PURE AMD Radeon RX 7800 XT</li>
                  <li>Kingston FURY Beast 2x16GB 5600MHz CL36 DDR5</li>
                  <li>ASRock B760M PG SONIC WiFi</li>
                  <li>Arch Linux + Windows 10 Dual Boot</li>
               </ul>
            </div>
            <div>
               <h3>VR Setup</h3>
               <ul>
                  <li>PlayStation VR2</li>
                  <li>PlayStation VR2 Sense Controller Charging Station</li>
                  <li>Aolion For PSVR2 PC Adapter</li>
                  <li>Project Babble DIY</li>
                  <li>SlimeVR DIY BMI160 (8+3)</li>
               </ul>
            </div>
            <div>
               <h3>Peripherals</h3>
               <ul>
                  <li>AOC 24&quot; Gaming 24G2SP</li>
                  <li>LG 29&quot; UltraWide FHD 29WQ600-W</li>
                  <li>Dell 24&quot; UltraSharp U2412M</li>
                  <li>Audio-Technica ATH-M40x</li>
                  <li>Boya BY-M1000</li>
                  <li>Ducky One 2 Tuxedo Full Size</li>
                  <li>Logitech G502 Hero</li>
                  <li>HyperX FURY S PRO Speed Edition XL</li>
                  <li>Logitech C922 Pro Stream</li>
                  <li>Keychron K3 V2</li>
               </ul>
            </div>
            <div>
               <h3>Others</h3>
               <ul>
                  <li>Samsung Galaxy S22+</li>
                  <li>Artillery Sidewinder X2</li>
                  <li>Tesco Banquet Table</li>
                  <li>IKEA MICKE desk</li>
                  <li>Steelcase V2 Think Office Chair</li>
               </ul>
            </div>
         </div>
         <p class="punk-note">I update this list when my setup changes.</p>
      </div>
   </section>
</MainLayout>

<script>
   import '../scripts/home-motion';
   import '../scripts/home-ambient';

   const updateAge = () => {
      const ageElement = document.querySelector('[data-age]');
      if (!(ageElement instanceof HTMLElement) || !ageElement.dataset.birthDate) {
         return;
      }

      const birthDate = new Date(`${ageElement.dataset.birthDate}T00:00:00Z`);
      const today = new Date();
      let age = today.getUTCFullYear() - birthDate.getUTCFullYear();
      if (
         today.getUTCMonth() < birthDate.getUTCMonth() ||
         (today.getUTCMonth() === birthDate.getUTCMonth() &&
            today.getUTCDate() < birthDate.getUTCDate())
      ) {
         age -= 1;
      }
      ageElement.textContent = age.toString();
   };

   updateAge();
   if (!document.documentElement.dataset.ageUpdaterBound) {
      document.addEventListener('astro:page-load', updateAge);
      document.documentElement.dataset.ageUpdaterBound = 'true';
   }
</script>
