      /* ===== Homepage publication rhythm below the frozen hero. ===== */
      .home-section {
         position: relative;
         padding-block: clamp(5rem, 8vw, 8.5rem);
         isolation: isolate;
         overflow-x: clip;
         overflow-y: visible;

         > .site-shell {
            position: relative;
            z-index: 1;
         }

         &--featured {
            padding-top: clamp(7rem, 11vw, 11rem);
         }

         /* A shallow tail closes the hero without carrying its full density down. */
         &--featured::before,
         &--featured::after {
            content: '';
            position: absolute;
            left: 0;
            top: -3.8rem;
            pointer-events: none;
            mask-repeat: no-repeat;
         }

         &--featured::before {
            top: -1.2rem;
            width: min(48vw, 34rem);
            height: 3.4rem;
            background: var(--color-paper);
            mask-image: url('../assets/ink/organic-drag-1.svg');
            mask-size: 100% 100%;
            opacity: 0.3;
            transform: rotate(-2deg);
         }

         &--featured::after {
            left: 26%;
            top: -1.8rem;
            width: min(32vw, 22rem);
            height: 4rem;
            background: color-mix(in srgb, var(--color-signal-red) 56%, var(--color-ink));
            mask-image: url('../assets/ink/pigment-pool-red.svg');
            mask-size: 100% 100%;
            opacity: 0.4;
         }

         &--skills::before,
         &--hardware::before,
         &--hardware::after {
            content: '';
            position: absolute;
            pointer-events: none;
            mask-repeat: no-repeat;
            mask-size: 100% 100%;
         }

         &--skills::before {
            right: 9%;
            top: -1.5rem;
            width: min(24vw, 18rem);
            height: 6rem;
            background: var(--color-paper);
            mask-image: url('../assets/ink/spray-fine-2.svg');
            opacity: 0.2;
            transform: rotate(8deg);
         }

         &--hardware::before {
            left: 4%;
            top: -1rem;
            width: min(16vw, 12rem);
            height: 3.8rem;
            background: var(--color-paper);
            mask-image: url('../assets/ink/spray-fine-2.svg');
            opacity: 0.19;
            transform: rotate(-11deg);
         }

         &--hardware::after {
            right: 6%;
            bottom: 4%;
            width: min(18vw, 13rem);
            height: 4.5rem;
            background: var(--color-ink-petrol);
            mask-image: url('../assets/ink/organic-drag-2.svg');
            opacity: 0.26;
            transform: rotate(3deg);
         }

         &--skills,
         &--hardware {
            padding-block: clamp(5.5rem, 8vw, 8rem);
         }
      }

      .punk-h3 {
         margin: 0;
         margin-top: 2.4rem;
         font-family: var(--font-mono);
         font-size: 0.92rem;
         font-weight: 700;
         letter-spacing: 0.14em;
         text-transform: uppercase;
         color: var(--color-paper);
      }

      .skills-field {
         position: relative;
         max-width: 68rem;
         margin-inline: auto;
         isolation: isolate;
      }

      .skills-group {
         position: relative;
         width: min(100%, 62rem);
         margin-top: 2.5rem;
         padding: 1.15rem 0.8rem 1.4rem;
         isolation: isolate;

         &--tools::before,
         &--topics::before {
            content: '';
            position: absolute;
            z-index: -1;
            pointer-events: none;
            mask-repeat: no-repeat;
            mask-size: 100% 100%;
         }

         &--tools::before {
            left: -3%;
            top: 0.15rem;
            width: min(58%, 32rem);
            height: 2.6rem;
            background: var(--color-ink-petrol);
            mask-image: url('../assets/ink/drybrush-paper.svg');
            opacity: 0.64;
            transform: rotate(-1.5deg);
         }

         &--topics {
            width: min(88%, 49rem);
            margin-left: clamp(0rem, 7vw, 6rem);
            transform: rotate(-0.25deg);
         }

         &--topics::before {
            right: -6%;
            bottom: 0.2rem;
            width: 62%;
            height: 1.5rem;
            background: var(--color-paper);
            mask-image: url('../assets/ink/organic-drag-1.svg');
            opacity: 0.32;
            transform: rotate(2deg);
         }
      }

      .skills-group {
         .punk-h3 {
            margin-top: 0;
         }
      }

      .skills-field {
         &::before {
            content: '';
            position: absolute;
            z-index: -1;
            left: 3%;
            top: 27%;
            width: min(66vw, 45rem);
            height: 7.5rem;
            background: linear-gradient(
               98deg,
               var(--color-paper) 0 61%,
               color-mix(in srgb, var(--color-paper) 84%, var(--color-signal-red)) 68%,
               var(--color-paper) 74%,
               color-mix(in srgb, var(--color-paper) 76%, var(--color-ink-petrol)) 83%,
               transparent 98%
            );
            mask-image: url('../assets/ink/organic-drag-1.svg');
            mask-size: 100% 100%;
            mask-repeat: no-repeat;
            opacity: 0.31;
            transform: rotate(-2deg);
         }

         &::after {
            content: '';
            position: absolute;
            z-index: -1;
            right: 4%;
            top: 42%;
            width: 31%;
            height: 6.5rem;
            background: linear-gradient(
               100deg,
               var(--color-paper),
               var(--color-ash) 62%,
               var(--color-ink-petrol) 84%,
               transparent
            );
            mask-image: url('../assets/ink/spray-fine-1.svg');
            mask-size: 100% 100%;
            mask-repeat: no-repeat;
            opacity: 0.14;
            transform: rotate(-6deg);
         }
      }

      /* Static inventory labels: varied paper slips, never selectable chips. */
      .punk-tags {
         display: flex;
         flex-wrap: wrap;
         gap: 0.68rem 0.48rem;
         margin: 1rem 0 0;
         padding: 0;

         li {
            position: relative;
            list-style: none;
            margin: 0;
            padding: 0.22rem 0.5rem;
            font-family: var(--font-mono);
            font-size: 0.86rem;
            font-weight: 700;
            line-height: 1.3;
            color: color-mix(in srgb, var(--color-paper) 90%, var(--color-ash));
            background: color-mix(in srgb, var(--color-deep-blue) 82%, var(--color-ink));
            clip-path: var(
               --print-paper-cut,
               polygon(2% 4%, 97% 0, 100% 88%, 95% 100%, 0 96%, 1% 18%)
            );
            isolation: isolate;
         }

         li::after {
            content: '';
            position: absolute;
            inset: 0;
            z-index: -1;
            background: var(--color-paper);
            mask-image: url('../assets/ink/scratch-field-1.svg');
            mask-size: 150% 170%;
            opacity: 0.07;
            pointer-events: none;
         }

         li:nth-child(4n + 1) {
            padding: 0.2rem 0.54rem;
            color: var(--color-ink);
            background: var(--color-paper);
            transform: rotate(0.6deg);
         }

         li:nth-child(4n + 2) {
            padding: 0.18rem 0.46rem;
            background: color-mix(in srgb, var(--color-ink) 92%, var(--color-deep-blue));
            transform: rotate(-0.5deg);
         }

         li:nth-child(4n + 3) {
            padding: 0.27rem 0.6rem;
            background: var(--color-deep-blue);
            box-shadow: 2px 0 0 rgb(237 23 56 / 42%);
            transform: rotate(0.8deg);
         }

         li:nth-child(4n) {
            padding: 0.22rem 0.52rem;
            background: color-mix(in srgb, #29466b 62%, var(--color-ink));
            transform: rotate(-0.8deg);
         }

         li:nth-child(5n) {
            translate: 0 0.22rem;
         }
      }

      .skills-group {
         &--tools .punk-tags li:nth-child(2),
         &--tools .punk-tags li:nth-child(24) {
            color: var(--color-paper);
            padding: 0.3rem 0.8rem;
            font-size: 1rem;
            letter-spacing: 0.02em;
         }

         &--tools .punk-tags li:nth-child(2)::before,
         &--tools .punk-tags li:nth-child(24)::before {
            content: '';
            position: absolute;
            z-index: 1;
            left: 8%;
            right: 7%;
            bottom: 0.08rem;
            height: 0.12rem;
            background: var(--color-signal-red);
            mask-image: url('../assets/ink/organic-drag-1.svg');
            mask-size: 100% 100%;
            mask-repeat: no-repeat;
            opacity: 0.62;
            transform: translateX(2px) rotate(-1deg);
            pointer-events: none;
         }

         &--tools .punk-tags li:nth-child(24)::before {
            background: var(--color-signal-cyan);
            transform: translateX(-2px) rotate(1deg);
         }
      }

      .punk-note {
         max-width: 65ch;
         margin-top: 1.5rem;
         font-size: 1rem;
         color: var(--color-ash);
      }

      /* Media remains rectangular; its accumulated print mount does not. */
      .punk-video {
         position: relative;
         width: min(92%, 66rem);
         margin: 3rem auto 0;
         padding: clamp(0.6rem, 1.5vw, 1.2rem);
         isolation: isolate;

         &::before,
         &::after {
            content: '';
            position: absolute;
            pointer-events: none;
            mask-repeat: no-repeat;
            mask-size: 100% 100%;
         }

         &::before {
            z-index: -2;
            left: -13%;
            top: -18%;
            width: 38%;
            height: 58%;
            background: linear-gradient(
               125deg,
               var(--color-paper),
               var(--color-ash) 72%,
               var(--color-ink-petrol) 88%
            );
            mask-image: url('../assets/ink/splatter-cluster-2.svg');
            opacity: 0.82;
            transform: rotate(-8deg);
         }

         &::after {
            z-index: -1;
            right: -11%;
            bottom: -16%;
            width: 48%;
            height: 28%;
            background: var(--color-paper);
            mask-image: url('../assets/ink/drybrush-paper.svg');
            opacity: 0.78;
            transform: rotate(5deg);
         }

         &__mount,
         &__navy,
         &__red {
            position: absolute;
            pointer-events: none;
         }

         &__mount :global(svg),
         &__navy :global(svg),
         &__red :global(svg) {
            width: 100%;
            height: 100%;
            display: block;
         }

         &__mount {
            z-index: -3;
            inset: -13% -7% -16% -9%;
            color: var(--color-paper);
            opacity: 0.9;
            transform: rotate(-2deg);
         }

         &__mount::after {
            content: '';
            position: absolute;
            inset: 9% 8% 7% 10%;
            background: var(--color-ink);
            mask-image: url('../assets/ink/scratch-field-1.svg');
            mask-size: 125% 150%;
            mask-repeat: no-repeat;
            opacity: 0.28;
            transform: rotate(1deg);
         }

         &__navy {
            z-index: -2;
            left: -12%;
            right: 10%;
            bottom: -12%;
            height: 27%;
            color: var(--color-ink-petrol);
            opacity: 0.76;
            transform: rotate(3deg);
         }

         &__red {
            z-index: -1;
            right: -7%;
            top: -8%;
            width: 38%;
            height: 44%;
            color: var(--color-signal-red);
            opacity: 0.46;
            mix-blend-mode: multiply;
            transform: rotate(8deg);
         }

         &__frame {
            position: relative;
            z-index: 1;
            background: var(--color-ink);
            box-shadow:
               -0.28rem 0.14rem 0 rgb(237 23 56 / 46%),
               0.24rem -0.12rem 0 rgb(104 131 173 / 28%);
            transform: rotate(-0.25deg);
         }

         &__frame::after {
            content: '';
            position: absolute;
            z-index: 2;
            right: 3%;
            bottom: -1.1rem;
            width: min(24%, 13rem);
            height: 3.4rem;
            background: linear-gradient(
               100deg,
               var(--color-paper),
               var(--color-ash) 65%,
               var(--color-signal-red) 78%,
               var(--color-ink-petrol) 90%,
               transparent
            );
            mask-image: url('../assets/ink/spray-fine-1.svg');
            mask-position: left center;
            mask-repeat: no-repeat;
            mask-size: 100% 100%;
            opacity: 0.26;
            transform: rotate(4deg);
            pointer-events: none;
         }
      }

      /* Supporting equipment: a photocopied service sheet, not a dashboard. */
      .punk-hardware {
         position: relative;
         display: grid;
         gap: 2.8rem clamp(2rem, 7vw, 6rem);
         max-width: 68rem;
         margin: 2.8rem auto 0;
         padding: clamp(1.4rem, 4vw, 2.8rem);
         border-block: 1px solid rgb(236 235 230 / 34%);
         isolation: isolate;

         &::before,
         &::after {
            content: '';
            position: absolute;
            pointer-events: none;
         }

         &::before {
            z-index: -1;
            inset: 3% 1% 5% -2%;
            background: linear-gradient(
               112deg,
               var(--color-deep-blue),
               color-mix(in srgb, var(--color-deep-blue) 72%, var(--color-ink-petrol)) 66%,
               var(--color-ink) 96%
            );
            mask-image: url('../assets/ink/heavy-ink-mass-1.svg');
            mask-size: 108% 124%;
            mask-repeat: no-repeat;
            opacity: 0.29;
            transform: rotate(-0.8deg);
         }

         &::after {
            left: 0;
            top: -0.35rem;
            width: 42%;
            height: 0.7rem;
            background: repeating-linear-gradient(
               90deg,
               var(--color-paper) 0 1px,
               transparent 1px 0.75rem
            );
            opacity: 0.5;
         }

         > div {
            position: relative;
            min-width: 0;
