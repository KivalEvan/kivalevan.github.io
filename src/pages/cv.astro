---
import BaseLayout from '../layouts/BaseLayout.astro';
import avatar from '../assets/img/avatar/kival_evan.jpg';
import bsee from '../assets/img/cv/bsee.png';
import bsmc from '../assets/img/cv/bsmc.png';
import chromapper from '../assets/img/cv/chromapper.png';
import cvContact from '../data/cvContact';
import { cvAward, cvEducation, cvSummary } from '../data/cvContent';
import { getImage } from 'astro:assets';
import type { GetImageResult } from 'astro';
import { Icon } from 'astro-icon/components';

const pageDetails = {
   title: 'CV',
   description: 'Software Engineer CV for Nabawi Azizul.',
   overrideTitle: false,
};

const cvName = 'Nabawi Azizul';
const cvTitle = 'Software Engineer';

interface Project {
   name: string;
   link?: string;
   type: string;
   points: string[];
   image?: GetImageResult;
}
const projects: Project[] = [
   {
      name: 'ChroMapper',
      link: 'https://github.com/Caeden117/ChroMapper/tree/dev',
      type: 'Ongoing open-source contributor | Unity, C#, HLSL',
      points: [
         'Contributed to the Unity 2021–Unity 6.3 migration. Refactored C# systems and HLSL shaders for runtime performance, memory use, and more accurate lighting previews.',
         'Implemented contextual editing and grouped-lighting workflows, including grid interaction, selection behavior, and paste handling for each editing mode.',
         'Added rotation-event editing for beatmap v2, v3, and v4, with synchronized grid and camera behavior, playback handling, and reduced-motion support.',
         'Reworked beatmap object scaling and model support to align editor geometry with Beat Saber environments.',
         'Hardened asynchronous AssetBundle loading through validation, component sanitization, cache invalidation, and deterministic cleanup.',
      ],
      image: await getImage({
         src: chromapper,
         alt: 'ChroMapper Preview',
         format: 'webp',
      }),
   },
   {
      name: 'Beat Saber Map Check',
      link: 'https://github.com/KivalEvan/BeatSaber-MapCheck',
      type: 'Personal Project | TypeScript, SolidJS',
      points: [
         'Built and maintain a TypeScript progressive web app used by more than 500 mappers. It checks beatmap metadata, statistics, and potential errors before release.',
         'Implemented validation across multiple beatmap versions and custom data types, with Vitest and jsdom fixtures for map loading and rule checks.',
         'Extracted parsing and domain logic into @kvl/bsmap, a reusable library with Deno checks, parallel tests, coverage, and npm/JSR publishing workflows.',
      ],
      image: await getImage({
         src: bsmc,
         alt: 'Beat Saber Map Check Preview',
         format: 'webp',
      }),
   },
   {
      name: 'Beat Saber Editor Enhanced',
      link: 'https://github.com/KivalEvan/BeatSaber-EditorEnhanced',
      type: 'Personal Project | Unity, C#, HLSL',
      points: [
         'Built and maintain a C# mod for the official Beat Saber editor that improves lighting and event-box editing workflows.',
         'Created interactive gizmos for v3 color, rotation, translation, and FX events, with drag, selection, lane scrolling, and context-aware creation.',
         'Added event-box tools for reordering, sorting, duplication, parameter replacement, and seed randomization, alongside math expressions and precision controls.',
         'Cached gizmo instances to improve runtime performance and removed a third-party dependency. Maintained fixes across editor updates.',
      ],
      image: await getImage({
         src: bsee,
         alt: 'Beat Saber Editor Enhanced Preview',
         format: 'webp',
      }),
   },
   {
      name: 'Autonomous Vehicle Display',
      type: 'In Progress | Qt, gRPC, RTP',
      points: [
         'Develop a local Qt display for an autonomous vehicle, integrated with an NVIDIA Jetson AGX Thor.',
         'Integrate vehicle telemetry and GPS data over gRPC for real-time display.',
         'Display live camera video received over RTP.',
      ],
   },
];

interface WorkExperience {
   title: string;
   company: string;
   position: string;
   start: Date;
   end?: Date;
   points: string[];
}
const works: WorkExperience[] = [
   {
      title: 'Software Developer',
      company: 'BGN IT Services',
      position: 'Full-time',
      start: new Date('2026-05-04'),
      points: [
         'Design and develop six company websites with Astro and Tailwind CSS for on-premises and cloud hosting.',
         'Maintain ASP.NET Core and C# systems and internal tools, focusing on performance and reliability.',
         'Build ASP.NET Core and C# tools that automate business processes.',
         'Research system improvements with potential infrastructure savings of approximately RM2,000 per year.',
      ],
   },
   {
      title: 'Data Engineer',
      company: 'InfinitiLab',
      position: 'Contract',
      start: new Date('2024-08-15'),
      end: new Date('2025-02-15'),
      points: [
         'Standardized data from multiple internal sources for a PETRONAS client to support a single source of truth.',
         'Built Python pipelines with Pandas and NumPy for database and API ingestion, format standardization, and record mapping to a master reference.',
         'Helped debug internal Python and C# tools and optimize database queries.',
      ],
   },
   {
      title: 'Web Developer',
      company: 'Azeus Convene',
      position: 'Internship',
      start: new Date('2022-05-15'),
      end: new Date('2022-08-15'),
      points: [
         'Built a reactive form with an internal form builder, JavaScript, jQuery, and REST APIs.',
         'Contributed to ETL backend design for data ingestion and extraction across MongoDB and other sources.',
         'Helped diagnose a local deployment issue with Bash scripts.',
      ],
   },
];

const skillGroups = [
   {
      name: 'Languages',
      items: ['C#', 'TypeScript', 'JavaScript', 'Python', 'C++', 'C', 'Bash', 'HLSL'],
   },
   {
      name: 'Web & Applications',
      items: [
         'ASP.NET Core',
         'Astro',
         'Tailwind CSS',
         'Svelte',
         'SolidJS',
         'Node.js',
         'Tauri',
         'REST APIs',
      ],
   },
   {
      name: 'Data & Databases',
      items: ['Pandas', 'NumPy', 'ETL', 'MySQL', 'MSSQL', 'PostgreSQL', 'MongoDB', 'SQLite'],
   },
   {
      name: 'Tools & Practices',
      items: [
         'Unity',
         'Git',
         'GitHub Actions',
         'Linux',
         'CMake',
         'Qt',
         'Blender',
         'Reverse Engineering',
      ],
   },
];

function formatMonth(date: Date): string {
   return new Intl.DateTimeFormat('en-US', {
      month: 'short',
      year: 'numeric',
      timeZone: 'UTC',
   }).format(date);
}

function formatYearMonth(date: Date): string {
   return date.toISOString().slice(0, 7);
}

const { src } = await getImage({
   src: avatar,
   alt: 'Portrait of Nabawi Azizul',
   format: 'webp',
   width: 256,
   height: 256,
});
---

<BaseLayout pageDetails={pageDetails} bodyClass="bg-[#f5f5f5] text-[#111]">
   <div class="cv-document min-h-screen w-full bg-[#f5f5f5] font-sans text-[#111]">
      <div
         class="cv-sheet relative mx-auto min-h-screen w-full max-w-[72rem] bg-[#f5f5f5] before:absolute before:left-3 before:top-3 before:h-6 before:w-6 before:border-l before:border-t before:border-[#f5f5f5] before:content-[''] after:absolute after:bottom-3 after:right-3 after:h-6 after:w-6 after:border-b after:border-r after:border-[#111] after:content-['']"
      >
         <header class="cv-profile bg-[#b74242] p-4 text-[#f5f5f5] sm:px-8 sm:py-6">
            <div class="flex flex-col gap-4 md:flex-row md:items-start">
               <div class="flex justify-center md:w-[11.25rem] md:shrink-0">
                  <img
                     src={src}
                     alt="Portrait of Nabawi Azizul"
                     class="h-40 w-40 rounded-full bg-[#ccc] object-cover md:h-[11.25rem] md:w-[11.25rem]"
                  />
               </div>
               <div class="min-w-0 flex-1 md:px-2">
                  <h1 class="text-[2.5rem] font-bold leading-tight">{cvName}</h1>
                  <p class="text-xl font-semibold">{cvTitle}</p>
                  <p class="mt-1.5">{cvSummary}</p>
               </div>
            </div>
            <div class="mt-4">
               <address class="flex flex-col gap-3 not-italic md:flex-row md:items-start">
                  <div class="flex w-full flex-col gap-1 md:w-1/2">
                     <span class="inline-flex items-center gap-1">
                        <Icon
                           name={cvContact.location.icon}
                           class="inline-block h-4 w-4 align-[-0.15em]"
                           aria-hidden="true"
                        />
                        <span>{cvContact.location.label}</span>
                     </span>
                     <span class="flex flex-wrap items-center gap-x-3 gap-y-1">
                        {
                           cvContact.methods.map((method) => (
                              <a
                                 href={method.href}
                                 class="inline-flex items-center gap-1 text-inherit underline decoration-current/50 underline-offset-2 hover:text-inherit hover:decoration-current"
                                 aria-label={method.ariaLabel}
                              >
                                 <Icon
                                    name={method.icon}
                                    class="inline-block h-4 w-4 shrink-0 align-[-0.15em]"
                                    aria-hidden="true"
                                 />
                                 <span>{method.label}</span>
                              </a>
                           ))
                        }
                     </span>
                  </div>
                  <div
                     class="flex w-full flex-wrap items-center gap-x-3 gap-y-1 md:w-1/2 md:justify-between"
                  >
                     {
                        cvContact.profiles.map((profile) => (
                           <a
                              href={profile.href}
                              class="inline-flex items-center gap-1 text-inherit underline decoration-current/50 underline-offset-2 hover:text-inherit hover:decoration-current"
                              aria-label={profile.ariaLabel}
                           >
                              <Icon
                                 name={profile.icon}
                                 class="inline-block h-4 w-4 shrink-0 align-[-0.15em]"
                                 aria-hidden="true"
                              />
                              <span>{profile.label}</span>
                           </a>
                        ))
                     }
                  </div>
               </address>
            </div>
         </header>
         <main class="cv-content p-4 sm:px-8 sm:py-6">
            <div class="cv-sections flex flex-col gap-8">
               <section class="cv-skills cv-section flex flex-col">
                  <h2
                     class="cv-section-title mb-3 grid w-full grid-cols-[1.5rem_auto_1fr] items-center gap-3 text-lg font-bold tracking-[0.12em] sm:text-xl sm:tracking-[0.1875em]"
                  >
                     <Icon
                        name="bi:star"
                        class="h-6 w-6 bg-[#b74242] p-1 text-[#f5f5f5]"
                        aria-hidden="true"
                     />
                     <span>TECHNICAL SKILLS</span>
                     <span class="h-px bg-[#b74242]" aria-hidden="true"></span>
                  </h2>
                  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                     {
                        skillGroups.map((group) => (
                           <div class="flex min-w-0 flex-col gap-1">
                              <h3 class="text-base font-bold">{group.name}</h3>
                              <ul class="flex flex-wrap gap-1 pl-0 [list-style:none]">
                                 {group.items.map((item) => (
                                    <li class="rounded border border-[#ccc] bg-white/50 px-2 py-0.5 text-sm">
                                       {item}
                                    </li>
                                 ))}
                              </ul>
                           </div>
                        ))
                     }
                  </div>
               </section>

               <section class="cv-work cv-section flex flex-col">
                  <h2
                     class="cv-section-title mb-3 grid w-full grid-cols-[1.5rem_auto_1fr] items-center gap-3 text-lg font-bold tracking-[0.12em] sm:text-xl sm:tracking-[0.1875em]"
                  >
                     <Icon
                        name="bi:briefcase"
                        class="h-6 w-6 bg-[#b74242] p-1 text-[#f5f5f5]"
                        aria-hidden="true"
                     />
                     <span>WORK EXPERIENCE</span>
                     <span class="h-px bg-[#b74242]" aria-hidden="true"></span>
                  </h2>
                  {
                     works.map((work) => (
                        <article class="cv-entry relative ml-3 border-l-2 border-[#b74242] pb-4 pl-5 before:absolute before:-left-[0.5625rem] before:top-0 before:block before:h-4 before:w-4 before:rounded-full before:border-2 before:border-[#b74242] before:bg-[#f5f5f5] before:content-[''] last:pb-0">
                           <h3 class="text-lg font-bold leading-tight">{work.title}</h3>
                           <div class="mb-1 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5">
                              <p class="font-semibold">
                                 {work.company} <span aria-hidden="true">·</span> {work.position}
                              </p>
                              <p class="whitespace-nowrap text-sm sm:text-base">
                                 <time datetime={formatYearMonth(work.start)}>
                                    {formatMonth(work.start)}
                                 </time>
                                 <span aria-hidden="true"> – </span>
                                 {work.end ? (
                                    <time datetime={formatYearMonth(work.end)}>
                                       {formatMonth(work.end)}
                                    </time>
                                 ) : (
                                    <span>Present</span>
                                 )}
                              </p>
                           </div>
                           <ul class="flex flex-col gap-1 pl-0 [list-style:none] [&>li]:flex [&>li::before]:mr-3 [&>li::before]:shrink-0 [&>li::before]:content-['»']">
                              {work.points.map((point) => (
                                 <li>{point}</li>
                              ))}
                           </ul>
                        </article>
                     ))
                  }
               </section>

               <section class="cv-education cv-section flex flex-col">
                  <h2
                     class="cv-section-title mb-3 grid w-full grid-cols-[1.5rem_auto_1fr] items-center gap-3 text-lg font-bold tracking-[0.12em] sm:text-xl sm:tracking-[0.1875em]"
                  >
                     <Icon
                        name="bi:book"
                        class="h-6 w-6 bg-[#b74242] p-1 text-[#f5f5f5]"
                        aria-hidden="true"
                     />
                     <span>EDUCATION</span>
                     <span class="h-px bg-[#b74242]" aria-hidden="true"></span>
                  </h2>
                  {
                     cvEducation.map((education) => (
                        <article class="cv-entry relative ml-3 border-l-2 border-[#b74242] pb-4 pl-5 before:absolute before:-left-[0.5625rem] before:top-0 before:block before:h-4 before:w-4 before:rounded-full before:border-2 before:border-[#b74242] before:bg-[#f5f5f5] before:content-[''] last:pb-0">
                           <h3 class="text-lg font-bold leading-tight">
                              {education.qualification}
                           </h3>
                           <p class="font-semibold">{education.institution}</p>
                           <p class="mt-1">
                              <time datetime={formatYearMonth(education.start)}>
                                 {formatMonth(education.start)}
                              </time>
                              <span aria-hidden="true"> – </span>
                              <time datetime={formatYearMonth(education.end)}>
                                 {formatMonth(education.end)}
                              </time>
                              <span aria-hidden="true"> · </span> {education.result}
                           </p>
                        </article>
                     ))
                  }
               </section>

               <section class="cv-projects cv-section flex flex-col">
                  <h2
                     class="cv-section-title mb-3 grid w-full grid-cols-[1.5rem_auto_1fr] items-center gap-3 text-lg font-bold tracking-[0.12em] sm:text-xl sm:tracking-[0.1875em]"
                  >
                     <Icon
                        name="bi:kanban"
                        class="h-6 w-6 bg-[#b74242] p-1 text-[#f5f5f5]"
                        aria-hidden="true"
                     />
                     <span>PROJECTS</span>
                     <span class="h-px bg-[#b74242]" aria-hidden="true"></span>
                  </h2>
                  {
                     projects.map((project) => (
                        <article class="cv-entry pb-5 last:pb-0">
                           <h3 class="text-lg font-bold leading-tight">
                              {project.link ? (
                                 <a
                                    href={project.link}
                                    class="text-[#b74242] underline decoration-current/40 underline-offset-2 hover:text-[#8f2f2f] hover:decoration-current"
                                 >
                                    {project.name}
                                    <Icon
                                       name="bi:link-45deg"
                                       class="inline-block h-4 w-4 align-[-0.15em]"
                                       aria-hidden="true"
                                    />
                                 </a>
                              ) : (
                                 project.name
                              )}
                           </h3>
                           <p class="font-semibold">{project.type}</p>
                           <div class="flow-root pt-1">
                              {project.image && (
                                 <figure class="mb-3 w-full max-w-[12rem] sm:float-right sm:mb-2 sm:ml-4 sm:w-[30%]">
                                    <img
                                       src={project.image.src}
                                       alt={`${project.name} project preview`}
                                       class="w-full rounded-lg"
                                    />
                                 </figure>
                              )}
                              <ul class="flex flex-col gap-1 pl-0 [list-style:none] [&>li]:flex [&>li::before]:mr-3 [&>li::before]:shrink-0 [&>li::before]:content-['»']">
                                 {project.points.map((point) => (
                                    <li>{point}</li>
                                 ))}
                              </ul>
                           </div>
                        </article>
                     ))
                  }
               </section>

               <section class="cv-award cv-section flex flex-col">
                  <h2
                     class="cv-section-title mb-3 grid w-full grid-cols-[1.5rem_auto_1fr] items-center gap-3 text-lg font-bold tracking-[0.12em] sm:text-xl sm:tracking-[0.1875em]"
                  >
                     <Icon
                        name="bi:trophy"
                        class="h-6 w-6 bg-[#b74242] p-1 text-[#f5f5f5]"
                        aria-hidden="true"
                     />
                     <span>AWARD</span>
                     <span class="h-px bg-[#b74242]" aria-hidden="true"></span>
                  </h2>
                  <article
                     class="cv-entry relative ml-3 border-l-2 border-[#b74242] pb-3 pl-5 before:absolute before:-left-[0.5625rem] before:top-0 before:block before:h-4 before:w-4 before:rounded-full before:border-2 before:border-[#b74242] before:bg-[#f5f5f5] before:content-['']"
                  >
                     <h3 class="text-lg font-bold leading-tight">{cvAward.title}</h3>
                     <p>
                        <time datetime={formatYearMonth(cvAward.start)}>
                           {formatMonth(cvAward.start)}
                        </time>
                        <span aria-hidden="true"> – </span>
                        <time datetime={formatYearMonth(cvAward.end)}>
                           {formatMonth(cvAward.end)}
                        </time>
                        <span aria-hidden="true"> · </span>
                        {cvAward.type}
                     </p>
                     <ul
                        class="mt-1 flex flex-col gap-1 pl-0 [list-style:none] [&>li]:flex [&>li::before]:mr-3 [&>li::before]:shrink-0 [&>li::before]:content-['»']"
                     >
                        {cvAward.points.map((point) => <li>{point}</li>)}
                     </ul>
                  </article>
               </section>
            </div>
         </main>
      </div>
   </div>
</BaseLayout>

<style is:global>
   .cv-document :focus-visible {
      outline-color: #111;
   }

   @page {
      size: A4 portrait;
      margin: 0;
   }

   @media print {
      html,
      body {
         width: 210mm;
         min-height: 297mm;
         background: #f5f5f5 !important;
         font-size: 9.5pt;
         print-color-adjust: exact;
         -webkit-print-color-adjust: exact;
      }

      body {
         display: block;
      }

      .cv-document,
      .cv-sheet {
         width: 210mm;
         max-width: none;
         min-height: 297mm;
      }

      .cv-profile {
         padding: 7mm 10mm;
         break-inside: avoid;
      }

      .cv-content {
         padding: 7mm 10mm;
      }

      .cv-sections {
         gap: 5mm;
      }

      .cv-section-title {
         break-after: avoid;
      }

      .cv-entry {
         break-inside: avoid;
      }

      .cv-projects {
         padding-top: 8mm;
         break-before: page;
      }

      .cv-sheet::before,
      .cv-sheet::after {
         display: none;
      }

      a {
         color: inherit;
         text-decoration-line: underline;
         text-decoration-thickness: 0.5pt;
         text-underline-offset: 1.5pt;
      }
   }
</style>
