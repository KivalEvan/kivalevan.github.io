---
import BaseLayout from '../layouts/BaseLayout.astro';
import avatar from '../assets/img/avatar/kival_evan.jpg';
import bsee from '../assets/img/cv/bsee.png';
import bsmc from '../assets/img/cv/bsmc.png';
import chromapper from '../assets/img/cv/chromapper.png';
import cvContact from '../data/cvContact';
import { cvAward, cvEducation, cvSummary } from '../data/cvContent';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { Icon } from 'astro-icon/components';

const pageDetails = {
   title: 'CV',
   description: 'Software Engineer CV for Nabawi Azizul.',
   overrideTitle: false,
};

const cvName = 'Nabawi Azizul';
const cvTitle = 'Software Engineer';

interface Project {
   name: string;
   link?: string;
   type: string;
   points: string[];
   image?: ImageMetadata;
}
const projects: Project[] = [
   {
      name: 'ChroMapper',
      link: 'https://github.com/Caeden117/ChroMapper/tree/dev',
      type: 'Core maintainer · Open source | Unity, C#, HLSL',
      points: [
         'Contributed to the migration from Unity 2021 to Unity 6.3.',
         'Refactored C# systems and HLSL shaders for performance, lower memory use, and lower-end hardware.',
         'Revamped lighting previews to match the game, added global lighting and custom assets, and created object/environment assets with Blender and GIMP.',
         'Implemented contextual editing and GLS workflows for grid interaction, selection, and pasting.',
         'Added v2–v4 rotation-event editing with synchronized grids, cameras, playback, and reduced-motion support.',
         'Improved beatmap format support and aligned object scaling and models with game environments.',
         'Hardened asynchronous AssetBundle loading with validation, component sanitization, cache invalidation, and deterministic cleanup.',
      ],
      image: chromapper,
   },
   {
      name: 'Beat Saber Map Check',
      link: 'https://github.com/KivalEvan/BeatSaber-MapCheck',
      type: 'Personal Project | TypeScript, SolidJS',
      points: [
         'Built and maintain a progressive web app used by 500+ mappers, with local archive and BeatSaver imports.',
         'Implemented configurable gameplay, lighting, and file-integrity checks with BeatLeader/ScoreSaber presets and Vitest/jsdom tests.',
         'Developed note/swing density and jump-speed statistics with filterable note distributions.',
         'Implemented beat-by-beat comparisons of added, removed, and modified gameplay objects.',
         'Extracted parsing and domain logic into @kvl/bsmap, with automated tests and npm/JSR publishing.',
      ],
      image: bsmc,
   },
   {
      name: 'Beat Saber Editor Enhanced',
      link: 'https://github.com/KivalEvan/BeatSaber-EditorEnhanced',
      type: 'Personal Project | Unity, C#, HLSL',
      points: [
         'Built and maintain a C# mod for the official Beat Saber editor, improving lighting workflows and compatibility across updates.',
         'Created interactive lighting gizmos with draggable, cached handles.',
         'Added batch tools for selection, duplication, sorting, mathematical expressions, and precision control.',
         'Implemented 3D motion path previews with beat markers and draggable translation and rotation controls.',
         'Contributed experimental features later added unofficially to Beat Saber.',
      ],
      image: bsee,
   },
   {
      name: 'Beat Saber Mapping Utility',
      link: 'https://github.com/KivalEvan/BeatSaber-MappingUtility',
      type: 'Personal Project | TypeScript, Angular',
      points: [
         'Built calculators for beat timing, note jump speed, jump distance, reaction time, and swing density comparisons across difficulties.',
         'Added color scheme editing with presets, perceptual colour comparisons, and JSON import/export.',
         'Developed configurable random pattern generation.',
      ],
   },
];

const freelance = {
   name: 'Autonomous Vehicle Display & Simulation',
   type: 'Freelance assignment · In progress | Qt, gRPC, RTP',
   points: [
      'Develop a Qt display for an autonomous vehicle with an NVIDIA Jetson AGX Thor.',
      'Integrate vehicle telemetry and GPS over gRPC, and live camera video over RTP.',
      'Build a 3D replica of a real-world map for autonomous vehicle simulation.',
   ],
};

interface WorkExperience {
   title: string;
   company: string;
   position: string;
   start: Date;
   end?: Date;
   points: string[];
}
const works: WorkExperience[] = [
   {
      title: 'Software Developer',
      company: 'IBIT',
      position: 'Contract',
      start: new Date('2026-05-04'),
      points: [
         'Develop six company websites with Astro and Tailwind CSS for on-premises and cloud hosting.',
         'Maintain ASP.NET Core and C# systems and build internal tools to automate business processes.',
         'Improve codebases, infrastructure, and security. Migrated and rebuilt a third-party project for on-premises deployment.',
         'Research system improvements with potential infrastructure savings of approximately RM2,000 per year.',
      ],
   },
   {
      title: 'Data Engineer',
      company: 'InfinitiLab',
      position: 'Contract',
      start: new Date('2024-08-15'),
      end: new Date('2025-02-15'),
      points: [
         'Standardized data from multiple internal sources for a PETRONAS client to support a single source of truth.',
         'Built Python pipelines with Pandas and NumPy to ingest database and API data, standardize formats, and match records to a master reference.',
         'Resolved inconsistencies in data and record matching. Helped debug internal Python and C# tools and optimize database queries.',
      ],
   },
   {
      title: 'Web Developer',
      company: 'Azeus Convene',
      position: 'Internship',
      start: new Date('2022-05-15'),
      end: new Date('2022-08-15'),
      points: [
         'Built a reactive form with an internal form builder, JavaScript, jQuery, and REST APIs.',
         'Contributed to ETL backend design across MongoDB and other sources. Helped diagnose a local deployment issue with Bash scripts.',
      ],
   },
];

const skillGroups = [
   {
      name: 'Languages',
      items: ['C#', 'TypeScript', 'JavaScript', 'Python', 'C++', 'C', 'HLSL'],
   },
   {
      name: 'Web & Applications',
      items: [
         'ASP.NET Core',
         'Astro',
         'SCSS',
         'Tailwind CSS',
         'Svelte',
         'SolidJS',
         'Angular',
         'Node.js',
         'Deno',
         'REST APIs',
      ],
   },
   {
      name: 'Data & Databases',
      items: ['Pandas', 'NumPy', 'ETL', 'MySQL', 'MSSQL', 'PostgreSQL', 'MongoDB', 'SQLite'],
   },
   {
      name: 'Tools & Practices',
      items: [
         'Unity',
         'Blender',
         'Git',
         'GitHub Actions',
         'Linux',
         'CMake',
         'Qt',
         'Reverse Engineering',
      ],
   },
];

function formatMonth(date: Date): string {
   return new Intl.DateTimeFormat('en-US', {
      month: 'short',
      year: 'numeric',
      timeZone: 'UTC',
   }).format(date);
}

function formatYearMonth(date: Date): string {
   return date.toISOString().slice(0, 7);
}
---

<BaseLayout pageDetails={pageDetails} bodyClass="cv-page">
   <div class="cv-document">
      <div class="cv-sheet">
         <header class="cv-profile">
            <div class="cv-profile__intro">
               <div class="cv-profile__portrait-wrap">
                  <Image
                     src={avatar}
                     alt="Portrait of Nabawi Azizul"
                     class="cv-profile__portrait"
                     format="webp"
                     width={256}
                     height={256}
                     loading="eager"
                  />
               </div>
               <div class="cv-profile__bio">
                  <h1 class="cv-profile__name">{cvName}</h1>
                  <p class="cv-profile__role">{cvTitle}</p>
                  <p class="cv-profile__summary">{cvSummary}</p>
               </div>
            </div>
            <div class="cv-profile__contact">
               <address class="cv-profile__address">
                  <div class="cv-profile__contact-group">
                     <span class="cv-profile__location">
                        <Icon
                           name={cvContact.location.icon}
                           class="cv-profile__icon"
                           aria-hidden="true"
                        />
                        <span>{cvContact.location.label}</span>
                     </span>
                     <span class="cv-profile__methods">
                        {cvContact.methods.map((method) => (
                           <a
                              href={method.href}
                              class="cv-profile__link"
                              aria-label={method.ariaLabel}
                           >
                              <Icon
                                 name={method.icon}
                                 class="cv-profile__icon cv-profile__icon--fixed"
                                 aria-hidden="true"
                              />
                              <span>{method.label}</span>
                           </a>
                        ))}
                     </span>
                  </div>
                  <div class="cv-profile__profiles">
                     {cvContact.profiles.map((profile) => (
                        <a
                           href={profile.href}
                           class="cv-profile__link"
                           aria-label={profile.ariaLabel}
                        >
                           <Icon
                              name={profile.icon}
                              class="cv-profile__icon cv-profile__icon--fixed"
                              aria-hidden="true"
                           />
                           <span>{profile.label}</span>
                        </a>
                     ))}
                  </div>
               </address>
            </div>
         </header>
         <main class="cv-content">
            <div class="cv-sections">
               <section class="cv-work cv-section">
                  <h2 class="cv-section-title">
                     <Icon name="bi:briefcase" class="cv-section-title__icon" aria-hidden="true" />
                     <span>WORK EXPERIENCE</span>
                     <span class="cv-section-title__rule" aria-hidden="true"></span>
                  </h2>
                  {works.map((work) => (
                     <article class="cv-entry cv-entry--timeline">
                        <h3 class="cv-entry__title">{work.title}</h3>
                        <div class="cv-entry__details">
                           <p class="cv-entry__subtitle">
                              {work.company} <span aria-hidden="true">·</span> {work.position}
                           </p>
                           <p class="cv-entry__dates">
                              <time datetime={formatYearMonth(work.start)}>
                                 {formatMonth(work.start)}
                              </time>
                              <span aria-hidden="true"> - </span>
                              {work.end ? (
                                 <time datetime={formatYearMonth(work.end)}>
                                    {formatMonth(work.end)}
                                 </time>
                              ) : (
                                 <span>Present</span>
                              )}
                           </p>
                        </div>
                        <ul class="cv-entry__points">
                           {work.points.map((point) => (
                              <li>{point}</li>
                           ))}
                        </ul>
                     </article>
                  ))}
               </section>

               <section class="cv-freelance cv-section">
                  <h2 class="cv-section-title">
                     <Icon name="bi:hammer" class="cv-section-title__icon" aria-hidden="true" />
                     <span>FREELANCE ENGINEERING</span>
                     <span class="cv-section-title__rule" aria-hidden="true"></span>
                  </h2>
                  <article class="cv-entry">
                     <h3 class="cv-entry__title">{freelance.name}</h3>
                     <p class="cv-entry__subtitle">{freelance.type}</p>
                     <ul class="cv-entry__points cv-entry__points--spaced">
                        {freelance.points.map((point) => (
                           <li>{point}</li>
                        ))}
                     </ul>
                  </article>
               </section>

               <section class="cv-skills cv-section">
                  <h2 class="cv-section-title">
                     <Icon name="bi:star" class="cv-section-title__icon" aria-hidden="true" />
                     <span>TECHNICAL SKILLS</span>
                     <span class="cv-section-title__rule" aria-hidden="true"></span>
                  </h2>
                  <div class="cv-skills__grid">
                     {skillGroups.map((group) => (
                        <div class="cv-skills__group">
                           <h3 class="cv-skills__heading">{group.name}</h3>
                           <ul class="cv-skills__tags">
                              {group.items.map((item) => (
                                 <li class="cv-skills__tag">{item}</li>
                              ))}
                           </ul>
                           <p class="cv-skills__print-list">{group.items.join(', ')}</p>
                        </div>
                     ))}
                  </div>
               </section>

               <section class="cv-education cv-section">
                  <h2 class="cv-section-title">
                     <Icon name="bi:book" class="cv-section-title__icon" aria-hidden="true" />
                     <span>EDUCATION</span>
                     <span class="cv-section-title__rule" aria-hidden="true"></span>
                  </h2>
                  {cvEducation.map((education) => (
                     <article class="cv-entry cv-entry--timeline">
                        <h3 class="cv-entry__title">{education.qualification}</h3>
                        <p class="cv-entry__subtitle">{education.institution}</p>
                        <p class="cv-entry__result">
                           <time datetime={formatYearMonth(education.start)}>
                              {formatMonth(education.start)}
                           </time>
                           <span aria-hidden="true"> - </span>
                           <time datetime={formatYearMonth(education.end)}>
                              {formatMonth(education.end)}
                           </time>
                           <span aria-hidden="true"> · </span> {education.result}
                        </p>
                     </article>
                  ))}
               </section>

               <section class="cv-projects cv-section">
                  <h2 class="cv-section-title">
                     <Icon name="bi:kanban" class="cv-section-title__icon" aria-hidden="true" />
                     <span>SELECTED PROJECTS</span>
                     <span class="cv-section-title__rule" aria-hidden="true"></span>
                  </h2>
                  {projects.map((project) => (
                     <article class="cv-entry cv-entry--project">
                        <h3 class="cv-entry__title">
                           {project.link ? (
                              <a href={project.link} class="cv-entry__link">
                                 {project.name}
                                 <Icon
                                    name="bi:link-45deg"
                                    class="cv-entry__link-icon"
                                    aria-hidden="true"
                                 />
                              </a>
                           ) : (
                              project.name
                           )}
                        </h3>
                        <p class="cv-entry__subtitle">{project.type}</p>
                        <div class="cv-entry__body">
                           {project.image && (
                              <figure class="cv-entry__figure">
                                 <Image
                                    src={project.image}
                                    alt={`${project.name} project preview`}
                                    class="cv-entry__image"
                                    style={`aspect-ratio: ${project.image.width} / ${project.image.height}`}
                                    format="webp"
                                    widths={[224, 448, 672, 1024]}
                                    sizes="12rem"
                                    loading="eager"
                                 />
                              </figure>
                           )}
                           <ul class="cv-entry__points">
                              {project.points.map((point) => (
                                 <li>{point}</li>
                              ))}
                           </ul>
                        </div>
                     </article>
                  ))}
               </section>

               <section class="cv-award cv-section">
                  <h2 class="cv-section-title">
                     <Icon name="bi:trophy" class="cv-section-title__icon" aria-hidden="true" />
                     <span>AWARD</span>
                     <span class="cv-section-title__rule" aria-hidden="true"></span>
                  </h2>
                  <article class="cv-entry cv-entry--timeline cv-entry--award">
                     <h3 class="cv-entry__title">{cvAward.title}</h3>
                     <p>
                        <time datetime={formatYearMonth(cvAward.start)}>
                           {formatMonth(cvAward.start)}
                        </time>
                        <span aria-hidden="true"> - </span>
                        <time datetime={formatYearMonth(cvAward.end)}>
                           {formatMonth(cvAward.end)}
                        </time>
                        <span aria-hidden="true"> · </span>
                        {cvAward.type}
                     </p>
                     <ul class="cv-entry__points cv-entry__points--spaced">
                        {cvAward.points.map((point) => (
                           <li>{point}</li>
                        ))}
                     </ul>
                  </article>
               </section>
            </div>
         </main>
      </div>
   </div>
</BaseLayout>

<style lang="scss">
   @layer layout {
      :global(body.cv-page) {
         background: #f5f5f5;
         color: #111;
      }

      .cv-document {
         --cv-leading-small: calc(1.25 / 0.875);
         --cv-leading-large: calc(1.75 / 1.125);
         width: 100%;
         min-height: 100vh;
         background: #f5f5f5;
         color: #111;
         font-family: var(--font-sans);
      }

      .cv-sheet {
         position: relative;
         width: 100%;
         max-width: 72rem;
         min-height: 100vh;
         margin-inline: auto;
         background: #f5f5f5;

         &::before,
         &::after {
            position: absolute;
            width: 1.5rem;
            height: 1.5rem;
            content: '';
         }

         &::before {
            top: 0.75rem;
            left: 0.75rem;
            border-top: 1px solid #f5f5f5;
            border-left: 1px solid #f5f5f5;
         }

         &::after {
            right: 0.75rem;
            bottom: 0.75rem;
            border-right: 1px solid #111;
            border-bottom: 1px solid #111;
         }
      }

      .cv-profile {
         padding: 1rem;
         background: #b74242;
         color: #f5f5f5;

         &__intro {
            display: flex;
            flex-direction: column;
            gap: 1rem;
         }

         &__portrait-wrap {
            display: flex;
            justify-content: center;
         }

         &__portrait {
            width: 10rem;
            height: 10rem;
            border-radius: 9999px;
            background: #ccc;
            object-fit: cover;
         }

         &__bio {
            min-width: 0;
            flex: 1 1 0%;
         }

         &__name {
            font-size: 2.5rem;
            font-weight: 700;
            line-height: 1.25;
         }

         &__role {
            font-size: 1.25rem;
            font-weight: 600;
            line-height: 1.4;
         }

         &__summary {
            margin-top: 0.375rem;
         }

         &__contact {
            margin-top: 1rem;
         }

         &__address {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            font-style: normal;
         }

         &__contact-group {
            display: flex;
            width: 100%;
            flex-direction: column;
            gap: 0.25rem;
         }

         &__location,
         &__link {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
         }

         &__methods,
         &__profiles {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            column-gap: 0.75rem;
            row-gap: 0.25rem;
         }

         &__profiles {
            width: 100%;
         }

         &__link {
            color: inherit;
            text-decoration-line: underline;
            text-decoration-color: color-mix(in oklab, currentColor 50%, transparent);
            text-underline-offset: 2px;

            &:hover {
               color: inherit;
               text-decoration-color: currentColor;
            }
         }
      }

      :global(.cv-profile__icon) {
         display: inline-block;
         width: 1rem;
         height: 1rem;
         vertical-align: -0.15em;
      }

      :global(.cv-profile__icon--fixed) {
         flex-shrink: 0;
      }

      .cv-content {
         padding: 1rem;
      }

      .cv-sections {
         display: flex;
         flex-direction: column;
         gap: 2rem;
      }

      .cv-section {
         display: flex;
         flex-direction: column;
      }

      .cv-section-title {
         display: grid;
         width: 100%;
         grid-template-columns: 1.5rem auto 1fr;
         align-items: center;
         gap: 0.75rem;
         margin-bottom: 0.75rem;
         font-size: 1.125rem;
         font-weight: 700;
         line-height: var(--cv-leading-large);
         letter-spacing: 0.12em;

         &__rule {
            height: 1px;
            background: #b74242;
         }
      }

      :global(.cv-section-title__icon) {
         width: 1.5rem;
         height: 1.5rem;
         padding: 0.25rem;
         background: #b74242;
         color: #f5f5f5;
      }

      .cv-entry {
         &__title {
            font-size: 1.125rem;
            font-weight: 700;
            line-height: 1.25;
         }

         &__subtitle {
            font-weight: 600;
         }

         &__details {
            display: flex;
            flex-wrap: wrap;
            align-items: baseline;
            justify-content: space-between;
            column-gap: 1rem;
            row-gap: 0.125rem;
            margin-bottom: 0.25rem;
         }

         &__dates {
            white-space: nowrap;
            font-size: 0.875rem;
            line-height: var(--cv-leading-small);
         }

         &__result,
         &__points--spaced {
            margin-top: 0.25rem;
         }

         &__points {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
            padding-left: 0;
            list-style: none;

            > li {
               display: flex;

               &::before {
                  margin-right: 0.75rem;
                  flex-shrink: 0;
                  content: '»';
               }
            }
         }

         &__link {
            color: #b74242;
            text-decoration-line: underline;
            text-decoration-color: color-mix(in oklab, currentColor 40%, transparent);
            text-underline-offset: 2px;

            &:hover {
               color: #8f2f2f;
               text-decoration-color: currentColor;
            }
         }

         &__body {
            display: flow-root;
            padding-top: 0.25rem;
         }

         &__figure {
            width: 100%;
            max-width: 12rem;
            margin-bottom: 0.75rem;
         }

         &__image {
            width: 100%;
            border-radius: 0.5rem;
         }

         &--timeline {
            position: relative;
            margin-left: 0.75rem;
            padding-bottom: 1rem;
            padding-left: 1.25rem;
            border-left: 2px solid #b74242;

            &::before {
               position: absolute;
               top: 0;
               left: -0.5625rem;
               display: block;
               width: 1rem;
               height: 1rem;
               border: 2px solid #b74242;
               border-radius: 9999px;
               background: #f5f5f5;
               content: '';
            }

            &:last-child {
               padding-bottom: 0;
            }
         }

         &--project {
            padding-bottom: 1.25rem;

            &:last-child {
               padding-bottom: 0;
            }
         }

         &--award {
            &:last-child {
               padding-bottom: 0.75rem;
            }
         }
      }

      :global(.cv-entry__link-icon) {
         display: inline-block;
         width: 1rem;
         height: 1rem;
         vertical-align: -0.15em;
      }

      .cv-skills {
         &__grid {
            display: grid;
            grid-template-columns: repeat(1, minmax(0, 1fr));
            gap: 0.75rem;
         }

         &__group {
            display: flex;
            min-width: 0;
            flex-direction: column;
            gap: 0.25rem;
         }

         &__heading {
            font-size: 1rem;
            font-weight: 700;
            line-height: 1.5;
         }

         &__tags {
            display: flex;
            flex-wrap: wrap;
            gap: 0.25rem;
            padding-left: 0;
            list-style: none;
         }

         &__tag {
            padding: 0.125rem 0.5rem;
            border: 1px solid #ccc;
            border-radius: 0.25rem;
            background: #ffffff80;
            font-size: 0.875rem;
            line-height: var(--cv-leading-small);
         }

         &__print-list {
            display: none;
         }
      }

      @media (min-width: 40rem) {
         .cv-profile,
         .cv-content {
            padding: 1.5rem 2rem;
         }

         .cv-section-title {
            font-size: 1.25rem;
            line-height: 1.4;
            letter-spacing: 0.1875em;
         }

         .cv-entry {
            &__dates {
               font-size: 1rem;
               line-height: 1.5;
            }

            &__figure {
               float: right;
               width: 30%;
               margin-bottom: 0.5rem;
               margin-left: 1rem;
            }
         }

         .cv-skills__grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
         }
      }

      @media (min-width: 48rem) {
         .cv-profile {
            &__intro,
            &__address {
               flex-direction: row;
               align-items: flex-start;
            }

            &__portrait-wrap {
               width: 11.25rem;
               flex-shrink: 0;
            }

            &__portrait {
               width: 11.25rem;
               height: 11.25rem;
            }

            &__bio {
               padding-inline: 0.5rem;
            }

            &__contact-group,
            &__profiles {
               width: 50%;
            }

            &__profiles {
               justify-content: space-between;
            }
         }
      }

      @media print {
         .cv-skills {
            &__tags {
               display: none;
            }

            &__print-list {
               display: block;
            }
         }
      }
   }

   .cv-document :focus-visible {
      outline-color: #111;
   }

   @page {
