---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTopButton from '../components/BackToTopButton.astro';
import InkBackdrop from '../components/InkBackdrop.astro';
import type { PageDetails } from '../data/page';
import '../styles/print-pages.scss';
import '../styles/interior-collage.scss';
import '../styles/home-background.scss';

interface Props {
   pageDetails: PageDetails;
}

const { pageDetails } = Astro.props;
---

<BaseLayout
   pageDetails={pageDetails}
   bodyClass={Astro.url.pathname === '/' ? undefined : 'print-page'}
>
   <a class="skip-link" href="#main-content">
      {' '}
      Skip to main content{' '}
   </a>
   <InkBackdrop />
   <Header pageDetails={pageDetails} />
   <main
      id="main-content"
      tabindex="-1"
      data-page-stagger-root
      class="site-main"
      transition:name="page-content"
      transition:animate="none"
   >
      {Astro.url.pathname !== '/' && <h1 class="sr-only">{pageDetails.title}</h1>}
      <slot />
   </main>
   <BackToTopButton />
   <Footer />
</BaseLayout>

<style lang="scss">
   @layer layout {
      .site-main {
         position: relative;
         z-index: 10;
         display: flex;
         min-height: 0;
         width: 100%;
         flex: 1;
         flex-direction: column;
         align-items: center;
         padding-bottom: 2rem;
      }
   }
</style>
