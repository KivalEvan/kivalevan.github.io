---
import Head from '../components/Head.astro';
import type { PageDetails } from '../data/page';
import '../styles/global.scss';
import '../styles/site-components.scss';
import '../styles/print-page-motion.scss';
import {
   PRINT_MOTION_BOOT_TIMEOUT,
   PRINT_MOTION_ENTRANCE_SELECTOR,
} from '../scripts/print-motion-targets';

export type { PageDetails } from '../data/page';

export interface Props {
   pageDetails: PageDetails;
   bodyClass?: string;
}

const { pageDetails, bodyClass } = Astro.props as Props;
const { title, description, browserTitle, overrideTitle } = pageDetails;
const headTitle = overrideTitle
   ? title
   : 'Kival Evan' + (title ? ` | ${browserTitle ? browserTitle : title}` : '');
const canonicalURL = new URL(Astro.url);
canonicalURL.search = '';
canonicalURL.hash = '';
if (canonicalURL.pathname !== '/') {
   canonicalURL.pathname = canonicalURL.pathname.replace(/\/+$/, '');
}
---

<!doctype html>
<html transition:name="root" transition:animate="none" lang="en">
   <Head title={headTitle} description={description} permalink={canonicalURL.href} />
   <body id="top-of-page" class={bodyClass}>
      <slot />
      <div class="page-loading-indicator">
         <p
            id="page-loading-status"
            class="page-loading-status"
            role="status"
            aria-atomic="true"
         ></p>
      </div>
      <!-- Keep preparation inline: a delayed or failed module must still expose the page. -->
      <script
         is:inline
         define:vars={{
            printMotionBootTimeout: PRINT_MOTION_BOOT_TIMEOUT,
            printMotionEntranceSelector: PRINT_MOTION_ENTRANCE_SELECTOR,
         }}
      >
         (() => {
            const root = document.documentElement;
            if (
               !document.body.classList.contains('print-page') ||
               window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
               root.dataset.printMotionBoot === 'expired' ||
               root.dataset.printMotionBoot === 'ready'
            ) {
               return;
            }
            const bootId = root.dataset.printMotionBootId ?? String(Date.now());
            root.dataset.printMotionBootId = bootId;
            root.dataset.printMotionBoot = 'pending';
            const candidates = Array.from(document.querySelectorAll(printMotionEntranceSelector));
            const targets = candidates.filter(
               (target) =>
                  !candidates.some((parent) => parent !== target && parent.contains(target)),
            );
            targets.forEach((target) =>
               target.setAttribute('data-print-motion-prepared', 'pending'),
            );
            const revealFor = (target) => {
               const plate = targets.find((candidate) => candidate.contains(target));
               plate?.removeAttribute('data-print-motion-prepared');
            };
            const onFocus = (event) => {
               if (event.target instanceof Element) revealFor(event.target);
            };
            document.addEventListener('focusin', onFocus);
            try {
               const hashTarget = document.getElementById(
                  decodeURIComponent(location.hash.slice(1)),
               );
               if (hashTarget) revealFor(hashTarget);
            } catch {
               // An invalid percent-encoded hash must not stop the fail-open bootstrap.
            }
            const cleanupBoot = () => {
               window.clearTimeout(bootTimer);
               document.removeEventListener('focusin', onFocus);
               document.removeEventListener('astro:before-swap', cleanupBoot);
            };
            const bootTimer = window.setTimeout(() => {
               cleanupBoot();
               if (
                  root.dataset.printMotionBoot !== 'pending' ||
                  root.dataset.printMotionBootId !== bootId
               ) {
                  return;
               }
               root.dataset.printMotionBoot = 'expired';
               targets.forEach((target) => target.removeAttribute('data-print-motion-prepared'));
            }, printMotionBootTimeout);
            document.addEventListener('astro:before-swap', cleanupBoot, { once: true });
         })();
      </script>
   </body>
</html>

<script>
   import '../scripts/site-navigation';
</script>

<script>
   import '../scripts/print-page-motion';
</script>

<style lang="scss">
   .page-loading-indicator {
      /* Inline this small existing contour: loading feedback must not wait on another request. */
      --loading-splatter: url('../assets/ink/splatter-cluster-1.svg?inline');
      position: fixed;
      z-index: 10;
      inset-inline-start: max(1.5rem, env(safe-area-inset-left));
      inset-block-end: max(2rem, env(safe-area-inset-bottom));
      isolation: isolate;
      pointer-events: none;

      &::before,
      &::after {
         content: '';
         position: absolute;
         z-index: -1;
         mask: var(--loading-splatter) center / 100% 100% no-repeat;
      }

      &::before {
         width: 7rem;
         height: 6rem;
         inset-inline-start: -1.5rem;
         inset-block-end: 0.75rem;
         background: #ff173c;
         transform: rotate(-17deg);
      }

      &::after {
         width: 7rem;
         height: 5.5rem;
         inset-inline-end: -2rem;
         inset-block-start: -0.5rem;
         background: #00b9d6;
         transform: rotate(23deg);
      }

      &:has(.page-loading-status:empty) {
         display: none;
      }
   }

   .page-loading-status {
      position: relative;
      margin: 0;
      padding: 0.5rem 0.875rem;
      color: #f4f3ef;
      background: #030305;
   }

   @media print {
      .page-loading-indicator {
         display: none;
      }
   }
</style>
