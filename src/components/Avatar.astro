---
import image from '../assets/img/avatar/kival_evan.jpg';
import { Image } from 'astro:assets';

interface Props {
   /** Alternative text. Use an empty value for duplicate decorative print plates. */
   alt?: string;
   class?: string;
}

const { alt = 'Kival Evan avatar', class: className = '' } = Astro.props;
---

<Image
   inferSize
   loading="eager"
   fetchpriority="high"
   alt={alt}
   src={image}
   class={`aspect-square h-auto w-full object-cover ${className}`}
/>
