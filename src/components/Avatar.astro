---
import image from '../assets/img/avatar/kival_evan.jpg';
import { Image } from 'astro:assets';

interface Props {
   /** Alternative text. Use an empty value for duplicate decorative print plates. */
   alt?: string;
   class?: string;
}

const { alt = 'Kival Evan avatar', class: className = '' } = Astro.props;
---

<Image loading="eager" fetchpriority="high" alt={alt} src={image} class={`avatar ${className}`} />

<style lang="scss">
   @layer layout {
      :global(.avatar) {
         aspect-ratio: 1;
         height: auto;
         width: 100%;
         object-fit: cover;
      }
   }
</style>
