---
import type { MarkdownInstance } from 'astro';
import type { Frontmatter } from '../../data/frontmatter';
import { formatDate, formatISODate } from '../../utils/date';

export interface Props {
   post: MarkdownInstance<Frontmatter>;
   featured?: boolean;
}

const { post, featured = false } = Astro.props as Props;
const { title, description, author, publishDate, updatedDate } = post.frontmatter;
const postUrl = post.url?.replace(/^(\/blog\/post\/[^./?#]+)\/?(?=[?#]|$)/, '$1/');
const formattedDate = formatDate(publishDate);
const publishDateTime = formatISODate(publishDate);
const formattedUpdatedDate = updatedDate ? formatDate(updatedDate) : undefined;
const updatedDateTime = updatedDate ? formatISODate(updatedDate) : undefined;
---

<article class={featured ? 'blog-preview blog-preview--featured' : 'blog-preview'}>
   <header class="blog-preview__header">
      <div class="blog-preview__title-wrap">
         <h3 class="blog-preview-title">
            <a class="blog-preview-title-link" href={postUrl}>
               {title}
            </a>
         </h3>
      </div>
      <div class="blog-preview-meta">
         <p>By {author}</p>
         <time datetime={publishDateTime}>Published {formattedDate}</time>
         {updatedDateTime && <time datetime={updatedDateTime}>Updated {formattedUpdatedDate}</time>}
      </div>
   </header>

   <p class="blog-preview__description">{description}</p>
   <a class="blog-preview-action print-action" href={postUrl}>
      Read post <span aria-hidden="true">→</span>
   </a>
</article>

<style lang="scss">
   @layer layout {
      .blog-preview {
         &__header {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            max-width: 65ch;
         }

         &__title-wrap {
            min-width: 0;
         }

         &__description {
            max-width: 65ch;
            margin-top: 1rem;
            line-height: 1.625;
         }
      }

      .blog-preview-title {
         font-size: 1.5rem;
         font-weight: 800;
         line-height: 1;
      }

      .blog-preview--featured .blog-preview-title {
         font-size: 1.875rem;
      }

      .blog-preview-meta {
         font-size: 0.875rem;
         line-height: 1.25rem;
         color: var(--color-site-muted);

         time {
            display: block;
         }
      }

      .blog-preview-action {
         gap: 0.5rem;
         margin-top: 0.75rem;
      }

      @media (min-width: 48rem) {
         .blog-preview-title {
            font-size: 1.875rem;
         }

         .blog-preview--featured .blog-preview-title {
            font-size: 2.25rem;
         }
      }
   }
</style>
