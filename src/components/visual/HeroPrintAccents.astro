<div class="hero-print-accents" aria-hidden="true">
   <span class="hero-print-accents__cut hero-print-accents__cut--tape">
      <span class="hero-print-accents__paper hero-print-accents__paper--tape"></span>
   </span>
</div>

<style lang="scss">
   .hero-print-accents {
      position: absolute;
      inset: 0;
      z-index: 5;
      pointer-events: none;

      &__cut {
         position: absolute;
         display: block;

         &--tape {
            left: -3%;
            top: 43%;
            width: clamp(6rem, 16vw, 14rem);
            height: 2.2rem;
            transform: rotate(17deg);
         }
      }

      &__paper {
         display: block;
         width: 100%;
         height: 100%;
         background-color: var(--color-paper);
         background-position: 0 0;
         clip-path: polygon(
            3% 2%,
            32% 5%,
            34% 0,
            72% 3%,
            96% 0,
            100% 13%,
            96% 42%,
            100% 47%,
            95% 79%,
            97% 96%,
            68% 100%,
            64% 96%,
            38% 100%,
            3% 95%,
            5% 71%,
            0 66%,
            4% 31%,
            0 25%
         );

         &--tape {
            background-image: repeating-linear-gradient(
               -65deg,
               transparent 0 6px,
               var(--color-ink) 6px 7px,
               transparent 7px 10px
            );
         }
      }
   }

   @media (max-width: 47.99rem) {
      .hero-print-accents {
         &__cut--tape {
            left: -8%;
            top: 36%;
            width: 42vw;
            height: 1.5rem;
         }
      }
   }
</style>
