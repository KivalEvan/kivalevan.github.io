---
import { Icon } from 'astro-icon/components';
---

<div
   transition:name="back-to-top"
   transition:animate="none"
   class="back-to-top z-50 self-end px-3 pb-3 md:fixed md:p-0"
   data-back-to-top
   hidden
>
   <a class="group block size-[46px] md:size-[48px]" href="#top-of-page" aria-label="Back to top">
      <span
         class="flex size-full items-center justify-center rounded-full bg-[#333] ring-[0.125rem] ring-inset ring-white transition-transform duration-200 group-hover:-translate-y-1 md:ring-[0.1875rem]"
      >
         <Icon name="bi:chevron-up" class="size-2/3 text-white" aria-hidden="true" />
      </span>
   </a>
</div>

<script>
   let footerVisible = false;
   let footerObserver: IntersectionObserver | undefined;

   const updateBackToTop = () => {
      const control = document.querySelector('[data-back-to-top]');
      if (!(control instanceof HTMLElement)) return;

      const threshold = Math.min(window.innerHeight * 0.75, 600);
      const overlaysContent = window.matchMedia('(min-width: 48rem)').matches;
      control.hidden = window.scrollY < threshold || (overlaysContent && footerVisible);
   };

   const observeFooter = () => {
      footerObserver?.disconnect();
      footerVisible = false;

      const footer = document.querySelector('footer');
      if (!(footer instanceof HTMLElement)) {
         updateBackToTop();
         return;
      }

      footerObserver = new IntersectionObserver(([entry]) => {
         footerVisible = entry.isIntersecting;
         updateBackToTop();
      });
      footerObserver.observe(footer);
      updateBackToTop();
   };

   observeFooter();
   if (!document.documentElement.dataset.backToTopBound) {
      window.addEventListener('scroll', updateBackToTop, { passive: true });
      window.addEventListener('resize', updateBackToTop, { passive: true });
      document.addEventListener('astro:page-load', observeFooter);
      document.documentElement.dataset.backToTopBound = 'true';
   }
</script>
