---
import { Icon } from 'astro-icon/components';
---

<div
   transition:name="back-to-top"
   transition:animate="none"
   class="back-to-top"
   data-back-to-top
   hidden
>
   <a class="back-to-top__link" href="#top-of-page" aria-label="Back to top">
      <span class="back-to-top__disc">
         <Icon name="bi:chevron-up" class="back-to-top__icon" aria-hidden="true" />
      </span>
   </a>
</div>

<script>
   let footerVisible = false;
   let footerObserver: IntersectionObserver | undefined;

   const updateBackToTop = () => {
      const control = document.querySelector('[data-back-to-top]');
      if (!(control instanceof HTMLElement)) return;

      const threshold = Math.min(window.innerHeight * 0.75, 600);
      const overlaysContent = window.matchMedia('(min-width: 48rem)').matches;
      control.hidden = window.scrollY < threshold || (overlaysContent && footerVisible);
   };

   const observeFooter = () => {
      footerObserver?.disconnect();
      footerVisible = false;

      const footer = document.querySelector('footer');
      if (!(footer instanceof HTMLElement)) {
         updateBackToTop();
         return;
      }

      footerObserver = new IntersectionObserver(([entry]) => {
         footerVisible = entry.isIntersecting;
         updateBackToTop();
      });
      footerObserver.observe(footer);
      updateBackToTop();
   };

   observeFooter();
   if (!document.documentElement.dataset.backToTopBound) {
      window.addEventListener('scroll', updateBackToTop, { passive: true });
      window.addEventListener('resize', updateBackToTop, { passive: true });
      document.addEventListener('astro:page-load', observeFooter);
      document.documentElement.dataset.backToTopBound = 'true';
   }
</script>

<style lang="scss">
   @layer layout {
      .back-to-top {
         z-index: 50;
         align-self: flex-end;
         padding-inline: 0.75rem;
         padding-bottom: 0.75rem;

         &__link {
            display: block;
            width: 46px;
            height: 46px;
         }

         &__disc {
            display: flex;
            width: 100%;
            height: 100%;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: #333;
            box-shadow: inset 0 0 0 0.125rem #fff;
            transition: none;
         }

         @media (hover: hover) {
            &__link:hover &__disc {
               translate: 0 -0.25rem;
            }
         }

         @media (min-width: 48rem) {
            position: fixed;
            padding: 0;

            &__link {
               width: 48px;
               height: 48px;
            }

            &__disc {
               box-shadow: inset 0 0 0 0.1875rem #fff;
            }
         }
      }
      :global(.back-to-top__icon) {
         width: calc(200% / 3);
         height: calc(200% / 3);
         color: #fff;
      }
   }
</style>
