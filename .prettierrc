{
   "plugins": ["prettier-plugin-astro", "prettier-plugin-svelte"],
   "overrides": [
      {
         "files": "*.astro",
         "options": {
            "parser": "astro"
         }
      },
      {
         "files": "*.svelte",
         "options": {
            "parser": "svelte"
         }
      }
   ],
   "semi": true,
   "singleQuote": true,
   "tabWidth": 3,
   "useTabs": false,
   "printWidth": 100
}
